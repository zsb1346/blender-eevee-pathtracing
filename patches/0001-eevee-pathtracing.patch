+            p_diff_N += cl.N * w;
+            diff_weight_sum += w;
+            break;
+          case CLOSURE_BSDF_MICROFACET_GGX_REFLECTION_ID: {
+            const float r = clamp(cl.data.x, 0.05f, 1.0f);
+            p_spec_color += cl.color;
+            p_spec_N += cl.N * w;
+            p_spec_roughness += r * w;
+            spec_weight_sum += w;
+            break;
+          }
+          case CLOSURE_BSDF_MICROFACET_GGX_REFRACTION_ID: {
+            const float r = clamp(cl.data.x, 0.02f, 1.0f);
+            p_transmit_color += (thickness.value() != 0.0f) ? (cl.color * cl.color) : cl.color;
+            p_transmit_N += cl.N * w;
+            p_transmit_roughness += r * w;
+            p_transmit_ior = max(cl.data.y, 1.01f);
+            p_transmit_type = 1u;
+            transmit_weight_sum += w;
+            break;
+          }
+          case CLOSURE_BSDF_THIN_GLASS_TRANSMISSION_ID: {
+            const float r = clamp(cl.data.x, 0.02f, 1.0f);
+            p_transmit_color += cl.color;
+            p_transmit_N += cl.N * w;
+            p_transmit_roughness += r * w;
+            p_transmit_type = 2u;
+            transmit_weight_sum += w;
+            break;
+          }
+          case CLOSURE_BSDF_TRANSLUCENT_ID:
+            p_transmit_color += (thickness.value() != 0.0f) ? (cl.color * cl.color) : cl.color;
+            p_transmit_N += cl.N * w;
+            p_transmit_type = 3u;
+            transmit_weight_sum += w;
+            break;
+          default:
+            break;
+        }
+      }
+    }
+
+    p_diff_N = (diff_weight_sum > 1e-6f) ? safe_normalize(p_diff_N, surface_N) : surface_N;
+    if (spec_weight_sum > 1e-6f) {
+      p_spec_N = safe_normalize(p_spec_N, surface_N);
+      p_spec_roughness = clamp(p_spec_roughness / spec_weight_sum, 0.05f, 1.0f);
+    }
+    else {
+      p_spec_N = surface_N;
+      p_spec_roughness = 1.0f;
+    }
+    if (transmit_weight_sum > 1e-6f) {
+      p_transmit_N = safe_normalize(p_transmit_N, surface_N);
+      p_transmit_roughness = clamp(p_transmit_roughness / transmit_weight_sum, 0.02f, 1.0f);
+    }
+    else {
+      p_transmit_N = surface_N;
+      p_transmit_roughness = 0.05f;
+    }
+
+    const float p_spec_alpha = p_spec_roughness * p_spec_roughness;
+    const float p_spec_alpha2 = p_spec_alpha * p_spec_alpha;
+    const float p_spec_ndotv = max(dot(p_spec_N, p_wo), 1e-4f);
+
+    /* NRD guide buffers & demodulation factors from resolved G-Buffer closures. */
+    nrd_normal = (spec_weight_sum > diff_weight_sum) ? p_spec_N : p_diff_N;
+    /* Glass/transmission: use the sharpest active lobe so NRD does not blur a refractive
+     * hit with a rough specular radius (the "virtual parallax" tracking artifact). */
+    if (spec_weight_sum > 1e-5f && transmit_weight_sum > 1e-5f) {
+      nrd_roughness = min(p_spec_roughness, p_transmit_roughness);
+    }
+    else if (spec_weight_sum > 1e-5f) {
+      nrd_roughness = p_spec_roughness;
+    }
+    else if (transmit_weight_sum > 1e-5f) {
+      nrd_roughness = p_transmit_roughness;
+    }
+    else {
+      nrd_roughness = 1.0f;
+    }
+    nrd_material_id = (diff_weight_sum < 1e-4f && spec_weight_sum > 1e-4f) ? 1.0f : 0.0f;
+    diff_factor = mix(float3(0.02f), float3(1.0f), saturate(p_diff_color));
+    spec_factor = mix(
+        float3(0.02f),
+        float3(1.0f),
+        saturate(max(p_spec_color, p_transmit_color)) * mix(0.1f, 1.0f, nrd_roughness));
+
+    /* --------------------------------------------------------
+     * 2. Primary direct lighting using G-Buffer closures (already Fresnel-weighted).
+     * -------------------------------------------------------- */
+    for (uint light_id = 0u; light_id < srt.pathtracing_data.light_count; light_id++) {
+      const LightRecord light = srt.light_buf[light_id];
+      const uint light_type = uint(light.position_type.w);
+      const float diff_fac = light.influence_shadow.x;
+      const float spec_fac = light.influence_shadow.y;
+      const bool cast_shadow = light.influence_shadow.z > 0.5f;
+      if (diff_fac <= 0.0f && spec_fac <= 0.0f) {
+        continue;
+      }
+
+      float3 light_position = light.position_type.xyz;
+      float3 wi;
+      float3 irradiance;
+      float shadow_distance;
+      float pdf_light_w = 0.0f;
+      bool is_area_light = false;
+
+      if (light_type == 1u) {
+        wi = safe_normalize(-light.direction_power.xyz, float3(0.0f, 0.0f, 1.0f));
+        irradiance = light.color_radius.rgb * light.direction_power.w;
+        shadow_distance = 1e30f;
+      }
+      else if (light_type == 4u) {
+        is_area_light = true;
+        const uint area_shape = uint(light.area_right.w);
+        const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+        const float2 uv = float2(rng.next(), rng.next());
+        float2 local;
+        if (area_shape == 4u) {
+          const float radius = sqrt(uv.x) * half_size.x;
+          const float phi = 2.0f * 3.14159265358979323846f * uv.y;
+          local = float2(cos(phi), sin(phi)) * radius;
+        }
+        else if (area_shape == 5u) {
+          const float radius = sqrt(uv.x);
+          const float phi = 2.0f * 3.14159265358979323846f * uv.y;
+          local = float2(cos(phi) * half_size.x, sin(phi) * half_size.y) * radius;
+        }
+        else {
+          local = (uv * 2.0f - 1.0f) * half_size;
+        }
+
+        light_position += light.area_right.xyz * local.x + light.area_up.xyz * local.y;
+        const float3 to_light = light_position - primary_hit_position;
+        const float distance_sq = dot(to_light, to_light);
+        const float distance = sqrt(distance_sq);
+        const float custom_att = light_custom_attenuation(distance, light.area_up.w);
+        if (custom_att <= 0.0f) {
+          continue;
+        }
+        wi = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+        const float cos_light = saturate(dot(-wi, light.direction_power.xyz));
+        if (cos_light <= 0.0f) {
+          continue;
+        }
+        const float area = max(area_light_area(light), 1e-6f);
+        pdf_light_w = distance_sq / max(area * cos_light, 1e-6f);
+        irradiance = light.color_radius.rgb * light.direction_power.w * cos_light * custom_att /
+                     max(3.14159265358979323846f * distance_sq, 1e-3f);
+        shadow_distance = distance;
+      }
+      else {
+        const float3 to_center = light.position_type.xyz - primary_hit_position;
+        const float center_dist_sq = dot(to_center, to_center);
+        const float center_dist = sqrt(center_dist_sq);
+        const float custom_att = light_custom_attenuation(center_dist, light.area_up.w);
+        if (custom_att <= 0.0f) {
+          continue;
+        }
+        const float light_radius = light.color_radius.a;
+        const float3 center_dir = safe_normalize(to_center, float3(0.0f, 0.0f, 1.0f));
+        const float3 sample_pos = (cast_shadow && center_dist > light_radius) ?
+                                      sample_light_disk_position(light.position_type.xyz,
+                                                                 center_dir,
+                                                                 light_radius,
+                                                                 rng.next(),
+                                                                 rng.next()) :
+                                      light.position_type.xyz;
+        const float3 to_light = sample_pos - primary_hit_position;
+        const float distance_sq = dot(to_light, to_light);
+        const float distance = sqrt(distance_sq);
+        wi = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+
+        const float r_sqr = light_radius * light_radius;
+        const float falloff = 2.0f / max(center_dist_sq + r_sqr +
+                                             center_dist * sqrt(center_dist_sq + r_sqr),
+                                         1e-4f);

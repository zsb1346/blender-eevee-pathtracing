   }
 
+  /* Newly added DNA fields read as zero in files saved before the field existed. Zero is also
+   * outside the RNA range and would leave the path tracer with no indirect bounce, making world
+   * lighting and shadowed areas appear completely black. */
+  for (Scene &scene : bmain->scenes) {
+    if (scene.eevee.pathtracing_max_bounces <= 0) {
+      scene.eevee.pathtracing_max_bounces = 8;

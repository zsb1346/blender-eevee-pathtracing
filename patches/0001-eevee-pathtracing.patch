+
+if(WIN32)
+  set(NRD_SAMPLE_ROOT "" CACHE PATH "Path to the NRD-Sample 4.17.1 root directory")
+  if(NOT NRD_SAMPLE_ROOT)
+    message(FATAL_ERROR
+      "NRD_SAMPLE_ROOT is not set. Configure with "
+      "-DNRD_SAMPLE_ROOT=<path-to-NRD-Sample-4.17.1>."
+    )
+  endif()
+  target_include_directories(bf_gpu PRIVATE
+    "${NRD_SAMPLE_ROOT}/External/NRD/Include"
+    "${NRD_SAMPLE_ROOT}/External/NRD/Integration"
+    "${NRD_SAMPLE_ROOT}/External/NRIFramework/External/NRI/Include"
+  )
+  target_link_libraries(bf_gpu PUBLIC
+    "${NRD_SAMPLE_ROOT}/_Bin/Release/NRD.lib"
+    "${NRD_SAMPLE_ROOT}/_Bin/Release/NRI.lib"
+  )
+endif()

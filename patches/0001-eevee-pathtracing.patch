+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Final temporal accumulation for the path tracing pipeline.
+ *
+ * Mirrors the NRD-Sample TAA stage: the composed image is accumulated with a
+ * reprojected history using a neighborhood color clamp. Keeping this pass after
+ * Composition is important because RELAX only denoises the indirect signal; the
+ * direct term and the material remodulation still carry per-frame noise.
+ */
+
+#pragma once
+
+#include "eevee_pathtracing_shared.hh"
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+struct TaaResources {
+  [[uniform(1)]] const PathTracingData &pathtracing_data;
+  /* Composed radiance written by the composite pass (RGB). */
+  [[image(0, read, SFLOAT_16_16_16_16)]] const image2D in_composed_img;
+  /* Non-jittered pixel motion (previous - current). */
+  [[image(1, read, SFLOAT_16_16_16_16)]] const image2D in_motion_img;
+  /* Previous TAA result. A is the previous current-frame weight. */
+  [[image(2, read, SFLOAT_16_16_16_16)]] const image2D in_history_img;
+  /* New TAA result for the next frame. A is the current-frame weight. */
+  [[image(3, write, SFLOAT_16_16_16_16)]] image2D out_history_img;
+  /* Linear view-space Z, used to pick the closest surface in the neighborhood for
+   * reprojection (NRD-Sample Taa.cs does the same through the motion texture). */
+  [[image(4, read, SFLOAT_32)]] const image2D in_viewz_img;
+  /* Debug path: output the reprojection motion instead of the accumulated color. */
+  [[push_constant]] const float debug_motion;
+  /* Debug View: pass the composed channel through without temporal accumulation. */
+  [[push_constant]] const float bypass_taa;
+};
+
+struct TaaFragOut {
+  [[frag_color(0)]] float4 color;
+};
+
+[[vertex]] void taa_vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void taa_frag([[frag_coord]] const float4 frag_co,
+                           [[resource_table]] TaaResources &srt,
+                           [[out]] TaaFragOut &frag_out)
+{
+  const int2 resolution = int2(srt.pathtracing_data.resolution);
+  const int2 texel = int2(frag_co.xy);
+  const int2 max_texel = resolution - int2(1);
+  /* Motion and viewZ are NRD textures (top-down Y); composed/history are raster space. */
+  const int2 nrd_texel = int2(texel.x, resolution.y - 1 - texel.y);
+  const float3 current = imageLoad(srt.in_composed_img, texel).rgb;
+  const float current_viewz = abs(imageLoad(srt.in_viewz_img, nrd_texel).r);
+
+  if (srt.debug_motion > 0.5f) {
+    /* Motion in pixels, signed: 0.5 is zero, 0/1 are -/+ 50 px. */
+    const float2 debug = imageLoad(srt.in_motion_img, nrd_texel).xy * 0.01f + 0.5f;
+    frag_out.color = float4(debug, 0.0f, 0.0f);
+    return;
+  }
+
+  if (srt.bypass_taa > 0.5f) {
+    /* Debug Views show a single-frame diagnostic signal (raw radiance, hit distance, ...).
+     * Re-projecting and blending it would smear exactly the detail being inspected. Write
+     * the composed pixel directly to both the screen and the history slot, tagging history
+     * as fully current so re-entering a normal view starts from a clean accumulation. */
+    imageStore(srt.out_history_img, texel, float4(current, 1.0f));
+    frag_out.color = float4(current, 0.0f);
+    return;
+  }
+
+  /* NRD-Sample uses a 5x5 neighborhood for thin/noisy surfaces (and sky). It also
+   * picks the closest neighborhood pixel's motion vector, which prevents a silhouette
+   * pixel from reprojecting the background history onto the foreground. */
+  float3 mean = float3(0.0f);
+  float3 second_moment = float3(0.0f);
+  float weight_sum = 0.0f;
+  float closest_viewz = current_viewz;
+  int2 closest_offset = int2(0, 0);
+  for (int dy = -2; dy <= 2; dy++) {
+    for (int dx = -2; dx <= 2; dx++) {
+      const int2 offset = int2(dx, dy);
+      const int2 p = clamp(texel + offset, int2(0), max_texel);
+      const float3 c = imageLoad(srt.in_composed_img, p).rgb;
+      const int2 nrd_p = int2(p.x, resolution.y - 1 - p.y);
+      const float viewz = abs(imageLoad(srt.in_viewz_img, nrd_p).r);
+      if (viewz < closest_viewz) {
+        closest_viewz = viewz;
+        closest_offset = offset;
+      }
+      const float2 normalized_offset = float2(offset) * 0.5f;
+      const float w = exp(-dot(normalized_offset, normalized_offset));
+      mean += c * w;
+      second_moment += c * c * w;
+      weight_sum += w;
+    }
+  }
+  mean /= weight_sum;
+  second_moment /= weight_sum;
+  float3 variance = second_moment - mean * mean;
+  variance.x = max(variance.x, 0.0f);
+  variance.y = max(variance.y, 0.0f);
+  variance.z = max(variance.z, 0.0f);
+  const float3 sigma = sqrt(variance) * 2.0f;
+
+  /* Reproject the history. MV is stored in pixels, previous - current, in NRD's top-down
+   * space; flip Y back to raster space and sample with the flipped texel. */
+  const int2 motion_p = clamp(texel + closest_offset, int2(0), max_texel);
+  float2 motion = imageLoad(srt.in_motion_img, int2(motion_p.x, resolution.y - 1 - motion_p.y)).xy;
+  motion.y = -motion.y;
+  /* `texel` is an integer index; its center is at texel + 0.5 in pixel coordinates. */
+  const float2 prev_pixel = float2(texel) + 0.5f + motion;
+  const bool in_screen = prev_pixel.x >= 0.0f && prev_pixel.y >= 0.0f &&
+                         prev_pixel.x < float(resolution.x) &&
+                         prev_pixel.y < float(resolution.y);
+
+  /* Bilinear history lookup with clamped coordinates. */
+  const float2 sample_pos = prev_pixel - 0.5f;
+  const int2 base = int2(floor(sample_pos));
+  const float2 frac = sample_pos - float2(base);
+  const float4 h00 = imageLoad(srt.in_history_img, clamp(base, int2(0), max_texel));
+  const float4 h10 = imageLoad(srt.in_history_img, clamp(base + int2(1, 0), int2(0), max_texel));
+  const float4 h01 = imageLoad(srt.in_history_img, clamp(base + int2(0, 1), int2(0), max_texel));
+  const float4 h11 = imageLoad(srt.in_history_img, clamp(base + int2(1, 1), int2(0), max_texel));
+  const float4 history = mix(mix(h00, h10, frac.x), mix(h01, h11, frac.x), frac.y);
+
+  /* Clamp history to the local color distribution to reject stale samples. */
+  float3 clamped_history;
+  clamped_history.x = clamp(history.x, mean.x - sigma.x, mean.x + sigma.x);
+  clamped_history.y = clamp(history.y, mean.y - sigma.y, mean.y + sigma.y);
+  clamped_history.z = clamp(history.z, mean.z - sigma.z, mean.z + sigma.z);
+
+  /* Validity is decided by the session-level flag and the in-screen test only. A zero
+   * `history.w` (mixRate == 0) is a legitimate "history matches current exactly" state
+   * from the previous frame; treating it as invalid resets the pixel every other frame
+   * and shows up as flicker on static flat regions. `mixRate` is saturate()d on write,
+   * so it can never be NaN or negative. */
+  const bool history_valid = (srt.pathtracing_data.taa_history_valid != 0u) && in_screen;
+
+  float mix_rate = clamp(history.w, 0.0f, 1.0f);
+  mix_rate /= (1.0f + mix_rate);
+  /* Reject history that disagrees with the current neighborhood. Weight luminance
+   * error less than chroma error: the eye is more sensitive to hue shifts (the red
+   * arc) than to small luminance differences. */
+  const float3 luma_weights = float3(0.2126f, 0.7152f, 0.0722f);
+  const float history_luma = max(1.0e-4f, dot(history.rgb, luma_weights));
+  const float3 history_error = abs(clamped_history - history.rgb);
+  const float luma_error = dot(history_error, luma_weights);
+  const float3 chroma_error = history_error - luma_weights * luma_error;
+  mix_rate = saturate(mix_rate + (luma_error * 0.5f + length(chroma_error) * 2.0f) /
+                                     history_luma);
+
+  /* Keep the minimum current-frame weight fixed. The neighborhood clamp above already
+   * rejects stale history, and using the current-frame variance to raise this weight
+   * prevents noisy pixels from ever accumulating. This matches the NRD TAA model, where
+   * the minimum weight is a constant and the history is clamped by the local color
+   * distribution instead. */
+  const float min_weight = 0.0606f;
+  const float current_weight = history_valid ? max(mix_rate, min_weight) : 1.0f;
+  const float3 result = mix(clamped_history, current, current_weight);
+
+  imageStore(srt.out_history_img, texel, float4(result, history_valid ? mix_rate : 1.0f));
+  /* EEVEE combined alpha stores transmittance (film converts with 1-alpha), so 0 = opaque. */
+  frag_out.color = float4(result, 0.0f);
+}
+
+PipelineGraphic taa(taa_vert, taa_frag);
+
+}  // namespace eevee::pathtracing
diff --git a/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_validation.bsl.hh b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_validation.bsl.hh

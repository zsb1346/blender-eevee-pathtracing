@@ -0,0 +1,52 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Overlays the optional NRD validation texture on the final TAA result.
+ *
+ * The validation texture is RGBA8: RGB is the NRD debug color and alpha is the
+ * per-layer transparency. This matches NRD-Sample's Final.cs.hlsl composition:
+ * `result = lerp(result, validation.xyz, validation.w)`.
+ */
+
+#pragma once
+
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+struct ValidationResources {
+  [[image(0, read, UNORM_8_8_8_8)]] const image2D in_validation_img;
+  [[image(1, read, SFLOAT_16_16_16_16)]] const image2D in_base_img;
+};
+
+struct ValidationFragOut {
+  [[frag_color(0)]] float4 color;
+};
+
+[[vertex]] void validation_vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void validation_frag([[frag_coord]] const float4 frag_co,
+                                  [[resource_table]] ValidationResources &srt,
+                                  [[out]] ValidationFragOut &frag_out)
+{
+  const int2 texel = int2(frag_co.xy);
+  /* NRD writes OUT_VALIDATION top-down (tile 0..3 at pixelPos.y == 0), so flip Y when
+   * overlaying it onto the raster-space base image. This also makes the 4x4 tile labels
+   * and color bars appear upright. */
+  const int2 extent = imageSize(srt.in_validation_img).xy;
+  const int2 nrd_texel = int2(texel.x, extent.y - 1 - texel.y);
+  const float4 validation = imageLoad(srt.in_validation_img, nrd_texel);
+  const float3 base = imageLoad(srt.in_base_img, texel).rgb;
+  frag_out.color = float4(mix(base, validation.rgb, validation.a), 0.0f);
+}
+
+PipelineGraphic validation(validation_vert, validation_frag);
+
+}  // namespace eevee::pathtracing

diff --git a/source/blender/gpu/vulkan/vk_nrd.cc b/source/blender/gpu/vulkan/vk_nrd.cc
new file mode 100644
index 0000000000000000000000000000000000000000..89240865597787934f2908e60d83231a1b651319
--- /dev/null
+++ b/source/blender/gpu/vulkan/vk_nrd.cc
@@ -0,0 +1,318 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Minimal NVIDIA NRD integration for the Vulkan backend.
+ *
+ * NRD is optional and only available in builds that link the external NRD/NRI
+ * libraries. The denoiser is recorded into a dedicated one-shot command buffer
+ * and submitted on Blender's graphics queue.
+ */
+
+#include <cstring>
+
+#include "BLI_assert.hh"
+
+#include "GPU_nrd.hh"
+
+#include "gpu_backend.hh"
+
+#include "vk_backend.hh"
+#include "vk_common.hh"
+#include "vk_device.hh"
+#include "vk_texture.hh"
+
+#include <NRI.h>
+#include <Extensions/NRIHelper.h>
+#include <Extensions/NRIRayTracing.h>
+#include <Extensions/NRIWrapperVK.h>
+#include <NRD.h>
+#include "NRDIntegration.hpp"
+
+namespace blender::gpu {
+
+namespace {
+
+struct NrdState {
+  nrd::Integration integration;
+  nrd::Identifier denoiser_id;
+  bool initialized = false;
+  int width = 0;
+  int height = 0;
+  uint32_t frame_index = 0;
+  float prev_view_to_clip[16] = {};
+  float prev_world_to_view[16] = {};
+  bool has_prev = false;
+  bool force_reset = false;
+  VkCommandPool command_pool = VK_NULL_HANDLE;
+  VkCommandBuffer command_buffer = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+};
+
+static NrdState *g_nrd_heap = new NrdState();
+static NrdState &g_nrd = *g_nrd_heap;
+
+static nrd::Resource nrd_resource(Texture *texture)
+{
+  VKTexture *vk_texture = static_cast<VKTexture *>(texture);
+  nrd::Resource resource = {};
+  resource.vk.image = (VKNonDispatchableHandle)vk_texture->vk_image_handle();
+  resource.vk.format = (VKEnum)to_vk_format(vk_texture->device_format_get());
+  resource.state.access = nri::AccessBits::SHADER_RESOURCE_STORAGE;
+  resource.state.layout = nri::Layout::GENERAL;
+  resource.state.stages = nri::StageBits::COMPUTE_SHADER;
+  return resource;
+}
+
+static bool nrd_init(VKDevice &device, int width, int height)
+{
+  if (g_nrd.initialized && g_nrd.width == width && g_nrd.height == height) {
+    return true;
+  }
+
+  if (g_nrd.initialized) {
+    g_nrd.integration.Destroy();
+    g_nrd.initialized = false;
+  }
+
+  /* NRD-Sample defaults to REBLUR at full resolution. It is more robust at geometry
+   * silhouettes than RELAX, whose 16x16 sky tiles can leave black fringes around edges. */
+  g_nrd.denoiser_id = nrd::Identifier(nrd::Denoiser::REBLUR_DIFFUSE_SPECULAR);
+
+  nrd::DenoiserDesc denoiser_desc = {};
+  denoiser_desc.identifier = g_nrd.denoiser_id;
+  denoiser_desc.denoiser = nrd::Denoiser::REBLUR_DIFFUSE_SPECULAR;
+
+  nrd::InstanceCreationDesc instance_desc = {};
+  instance_desc.denoisers = &denoiser_desc;
+  instance_desc.denoisersNum = 1;
+
+  nrd::IntegrationCreationDesc integration_desc = {};
+  std::strncpy(integration_desc.name, "EEVEE", sizeof(integration_desc.name) - 1);
+  integration_desc.resourceWidth = uint16_t(width);
+  integration_desc.resourceHeight = uint16_t(height);
+  integration_desc.queuedFrameNum = 1;
+  integration_desc.autoWaitForIdle = false;
+  integration_desc.promoteFloat16to32 = false;
+  integration_desc.demoteFloat32to16 = false;
+
+  nri::QueueFamilyVKDesc queue_family = {};
+  queue_family.familyIndex = device.queue_family_get();
+  queue_family.queueType = nri::QueueType::GRAPHICS;
+  queue_family.queueNum = 1;
+
+  nri::DeviceCreationVKDesc device_desc = {};
+  device_desc.vkInstance = (VKHandle)device.instance_get();
+  device_desc.vkPhysicalDevice = (VKHandle)device.physical_device_get();
+  device_desc.vkDevice = (VKHandle)device.vk_handle();
+  device_desc.minorVersion = 3;
+  device_desc.queueFamilies = &queue_family;
+  device_desc.queueFamilyNum = 1;
+  device_desc.enableNRIValidation = false;
+
+  if (g_nrd.integration.RecreateVK(integration_desc, instance_desc, device_desc) !=
+      nrd::Result::SUCCESS)
+  {
+    return false;
+  }
+
+  /* Copied from NRD-Sample's default REBLUR settings (NRDSample.cpp:271 and :580).
+   * The sample uses 31 accumulated / 7 fast frames, full-res checkerboard OFF and
+   * anti-firefly OFF. Our specular channel also contains dielectric highlights, so
+   * minMaterialForSpecular is 0 instead of the sample's metal-only 1. */
+  nrd::ReblurSettings settings = {};
+  settings.maxAccumulatedFrameNum = 31;
+  settings.maxFastAccumulatedFrameNum = 7;
+  settings.maxStabilizedFrameNum = 31;
+  settings.fastHistoryClampingSigmaScale = 1.5f;
+  settings.minMaterialForDiffuse = 0.0f;
+  settings.minMaterialForSpecular = 0.0f;
+  settings.enableAntiFirefly = false;
+  settings.checkerboardMode = nrd::CheckerboardMode::OFF;
+  settings.hitDistanceReconstructionMode = nrd::HitDistanceReconstructionMode::OFF;
+  g_nrd.integration.SetDenoiserSettings(g_nrd.denoiser_id, &settings);
+
+  g_nrd.width = width;
+  g_nrd.height = height;
+  g_nrd.frame_index = 0;
+  g_nrd.has_prev = false;
+  g_nrd.force_reset = true;
+  g_nrd.initialized = true;
+  return true;
+}
+
+}  // namespace
+
+bool nrd_denoise(const NrdDenoiseInput &input)
+{
+  if (!input.color || !input.specular || !input.normal_roughness || !input.viewz ||
+      !input.motion || !input.output || !input.output_specular || input.width <= 0 ||
+      input.height <= 0)
+  {
+    return false;
+  }
+  if (input.width > 65535 || input.height > 65535) {
+    return false;
+  }
+
+  GPUBackend *backend = GPUBackend::get();
+  if (backend == nullptr) {
+    return false;
+  }
+  VKBackend *vk_backend = dynamic_cast<VKBackend *>(backend);
+  if (vk_backend == nullptr) {
+    return false;
+  }
+  VKDevice &device = vk_backend->device;
+
+  if (!nrd_init(device, input.width, input.height)) { printf("[NRD] Init failed!\n");
+    return false;
+  }
+
+  VkDevice vk_device = device.vk_handle();
+  VkQueue vk_queue = device.queue_get();
+  if (vk_device == VK_NULL_HANDLE || vk_queue == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  if (g_nrd.command_pool == VK_NULL_HANDLE) {
+    VkCommandPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+    pool_info.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+    pool_info.queueFamilyIndex = device.queue_family_get();
+    if (device.functions.vkCreateCommandPool(
+            vk_device, &pool_info, nullptr, &g_nrd.command_pool) != VK_SUCCESS)
+    {
+      return false;
+    }
+  }
+
+  if (g_nrd.command_buffer == VK_NULL_HANDLE) {
+    VkCommandBufferAllocateInfo alloc_info = {};
+    alloc_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+    alloc_info.commandPool = g_nrd.command_pool;
+    alloc_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    alloc_info.commandBufferCount = 1;
+    if (device.functions.vkAllocateCommandBuffers(
+            vk_device, &alloc_info, &g_nrd.command_buffer) != VK_SUCCESS)
+    {
+      return false;
+    }
+  }
+
+  if (g_nrd.fence == VK_NULL_HANDLE) {
+    VkFenceCreateInfo fence_info = {};
+    fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    if (device.functions.vkCreateFence(vk_device, &fence_info, nullptr, &g_nrd.fence) != VK_SUCCESS)
+    {
+      return false;
+    }
+  }
+
+  g_nrd.integration.NewFrame();
+
+  nrd::CommonSettings common_settings = {};
+  if (input.view_to_clip) {
+    std::memcpy(common_settings.viewToClipMatrix, input.view_to_clip, 16 * sizeof(float));
+    std::memcpy(common_settings.viewToClipMatrixPrev,
+                g_nrd.has_prev ? g_nrd.prev_view_to_clip : input.view_to_clip,
+                16 * sizeof(float));
+  }
+  if (input.world_to_view) {
+    std::memcpy(common_settings.worldToViewMatrix, input.world_to_view, 16 * sizeof(float));
+    std::memcpy(common_settings.worldToViewMatrixPrev,
+                g_nrd.has_prev ? g_nrd.prev_world_to_view : input.world_to_view,
+                16 * sizeof(float));
+  }
+
+  if (input.view_to_clip && input.world_to_view) {
+    std::memcpy(g_nrd.prev_view_to_clip, input.view_to_clip, 16 * sizeof(float));
+    std::memcpy(g_nrd.prev_world_to_view, input.world_to_view, 16 * sizeof(float));
+    g_nrd.has_prev = true;
+  }
+
+  const bool reset_history = input.reset_history || g_nrd.force_reset;
+  g_nrd.force_reset = false;
+
+  common_settings.motionVectorScale[0] = 1.0f / float(input.width);
+  common_settings.motionVectorScale[1] = 1.0f / float(input.height);
+  /* 2.5D screen-space motion: xy in pixels, z = viewZprev - viewZ. */
+  common_settings.motionVectorScale[2] = 1.0f;
+  common_settings.resourceSize[0] = uint16_t(input.width);
+  common_settings.resourceSize[1] = uint16_t(input.height);
+  common_settings.resourceSizePrev[0] = uint16_t(input.width);
+  common_settings.resourceSizePrev[1] = uint16_t(input.height);
+  common_settings.rectSize[0] = uint16_t(input.width);
+  common_settings.rectSize[1] = uint16_t(input.height);
+  common_settings.rectSizePrev[0] = uint16_t(input.width);
+  common_settings.rectSizePrev[1] = uint16_t(input.height);
+  common_settings.viewZScale = input.view_z_scale;
+  common_settings.denoisingRange = input.denoising_range;
+  common_settings.cameraJitter[0] = input.camera_jitter[0];
+  common_settings.cameraJitter[1] = input.camera_jitter[1];
+  common_settings.cameraJitterPrev[0] = input.camera_jitter_prev[0];
+  common_settings.cameraJitterPrev[1] = input.camera_jitter_prev[1];
+  common_settings.disocclusionThreshold = 0.01f;
+  common_settings.disocclusionThresholdAlternate = 0.1f;
+  common_settings.frameIndex = g_nrd.frame_index++;
+  common_settings.accumulationMode = reset_history ? nrd::AccumulationMode::CLEAR_AND_RESTART :
+                                                      nrd::AccumulationMode::CONTINUE;
+  common_settings.isMotionVectorInWorldSpace = false;
+  common_settings.isHistoryConfidenceAvailable = false;
+  g_nrd.integration.SetCommonSettings(common_settings);
+
+  nrd::ResourceSnapshot snapshot = {};
+  snapshot.restoreInitialState = true;
+  snapshot.SetResource(nrd::ResourceType::IN_MV, nrd_resource(input.motion));
+  snapshot.SetResource(nrd::ResourceType::IN_NORMAL_ROUGHNESS,
+                       nrd_resource(input.normal_roughness));
+  snapshot.SetResource(nrd::ResourceType::IN_VIEWZ, nrd_resource(input.viewz));
+  snapshot.SetResource(nrd::ResourceType::IN_DIFF_RADIANCE_HITDIST, nrd_resource(input.color));
+  snapshot.SetResource(nrd::ResourceType::OUT_DIFF_RADIANCE_HITDIST, nrd_resource(input.output));
+  snapshot.SetResource(nrd::ResourceType::IN_SPEC_RADIANCE_HITDIST, nrd_resource(input.specular));
+  snapshot.SetResource(nrd::ResourceType::OUT_SPEC_RADIANCE_HITDIST,
+                       nrd_resource(input.output_specular));
+
+  if (device.functions.vkResetCommandPool(vk_device, g_nrd.command_pool, 0) != VK_SUCCESS) {
+    return false;
+  }
+  if (device.functions.vkResetFences(vk_device, 1, &g_nrd.fence) != VK_SUCCESS) {
+    return false;
+  }
+
+  VkCommandBufferBeginInfo begin_info = {};
+  begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+  begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  if (device.functions.vkBeginCommandBuffer(g_nrd.command_buffer, &begin_info) != VK_SUCCESS) {
+    return false;
+  }
+
+  nri::CommandBufferVKDesc command_buffer_desc = {};
+  command_buffer_desc.vkCommandBuffer = (VKHandle)(uintptr_t)g_nrd.command_buffer;
+  command_buffer_desc.queueType = nri::QueueType::GRAPHICS;
+  g_nrd.integration.DenoiseVK(&g_nrd.denoiser_id, 1, command_buffer_desc, snapshot);
+
+  if (device.functions.vkEndCommandBuffer(g_nrd.command_buffer) != VK_SUCCESS) {
+    return false;
+  }
+
+  VkSubmitInfo submit_info = {};
+  submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+  submit_info.commandBufferCount = 1;
+  submit_info.pCommandBuffers = &g_nrd.command_buffer;
+  if (device.functions.vkQueueSubmit(vk_queue, 1, &submit_info, g_nrd.fence) != VK_SUCCESS) {
+    return false;
+  }
+  if (device.functions.vkWaitForFences(vk_device, 1, &g_nrd.fence, VK_TRUE, UINT64_MAX) !=
+      VK_SUCCESS)
+  {
+    return false;
+  }
+
+  return true;
+}

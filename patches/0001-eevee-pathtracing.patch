diff --git a/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_composite.bsl.hh b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_composite.bsl.hh
new file mode 100644
index 00000000..e14da043
--- /dev/null
+++ b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_composite.bsl.hh
@@ -0,0 +1,171 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Composites the denoised path tracing result with the raw radiance for sky pixels.
+ *
+ * NRD denoisers do not write output pixels outside of the denoising range (sky).
+ * For those pixels the raw path traced radiance must be used instead, matching
+ * the reference composition in the NRD sample.
+ */
+
+#pragma once
+
+#include "eevee_pathtracing_shared.hh"
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+/* Composite writes directly to EEVEE's combined framebuffer so film.accumulate() can do the
+ * final temporal integration. There is no separate TAA pass anymore. EEVEE combined alpha
+ * stores transmittance (film converts with 1-alpha), so opaque pixels write alpha = 0. */
+struct CompositeFragOut {
+  [[frag_color(0)]] float4 color;
+};
+
+struct CompositeResources {
+  [[storage(0, read)]] const PathTracingAux (&in_aux_buf)[];
+  /* Raw indirect path traced radiance (RGB) and path hit distance (A). */
+  [[image(0, read, SFLOAT_16_16_16_16)]] const image2D in_radiance_img;
+  /* NRD denoised indirect radiance (RGB). */
+  [[image(1, read, SFLOAT_16_16_16_16)]] const image2D in_denoised_img;
+  /* NRD denoised specular indirect radiance (RGB). */
+  [[image(2, read, SFLOAT_16_16_16_16)]] const image2D in_denoised_spec_img;
+  /* Raw specular indirect path traced radiance (RGB) and path hit distance (A). */
+  [[image(3, read, SFLOAT_16_16_16_16)]] const image2D in_radiance_spec_img;
+  /* Primary-surface direct lighting (RGB). A stores linear view-space Z (fp16, debug only:
+   * fp16 saturates above ~65504, so it must not be used for the sky test). */
+  [[image(4, read, SFLOAT_16_16_16_16)]] const image2D in_direct_img;
+  /* SIGMA shadow output (R8). Squared before use, matching SIGMA_BackEnd_UnpackShadow. */
+  [[image(5, read, UNORM_8)]] const image2D in_shadow_img;
+  /* Linear view-space Z (R32F), the exact texture NRD tests against its denoising range.
+   * Sky classification must match NRD's own `abs(viewZ) >= denoisingRange` test. */
+  [[image(6, read, SFLOAT_32)]] const image2D in_viewz_img;
+  /* Must match the denoising range passed to NRD. */
+  [[push_constant]] const float denoising_range;
+  /* Debug path: bypass the denoised inputs and use the raw path traced signal. */
+  [[push_constant]] const float raw_only;
+  /* Debug channel selector. 0 = normal composition. */
+  [[push_constant]] const float debug_view;
+  /* Channel toggles for the final composition. */
+  [[push_constant]] const float use_direct;
+  [[push_constant]] const float use_diffuse;
+  [[push_constant]] const float use_specular;
+  /* Composite result for the final TAA pass. A stores 1 for written pixels. */
+  [[image(7, write, SFLOAT_16_16_16_16)]] image2D out_composed_img;
+};
+
+/* REBLUR operates in YCoCg space: the path tracing pass encodes its denoiser input and writes the
+ * denoised output in the same encoding. Convert back to linear before remodulating. */
+float3 ycocg_to_linear(float3 color)
+{
+  const float t = color.x - color.z;
+  return max(float3(t + color.y, color.x + color.z, t - color.y), float3(0.0f));
+}
+
+[[vertex]] void composite_vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void composite_frag([[frag_coord]] const float4 frag_co,
+                                 [[resource_table]] CompositeResources &srt,
+                                 [[out]] CompositeFragOut &frag_out)
+{
+  const int2 texel = int2(frag_co.xy);
+  const int2 extent = imageSize(srt.in_radiance_img).xy;
+  /* NRD textures are top-down (Y flipped); direct lighting, the SSBO and the output are in
+   * raster space. Sample the two spaces with separate texel coordinates. */
+  const int2 nrd_texel = int2(texel.x, extent.y - 1 - texel.y);
+  const uint aux_index = uint(texel.y) * uint(extent.x) + uint(texel.x);
+  const PathTracingAux aux = srt.in_aux_buf[aux_index];
+  const float4 raw = imageLoad(srt.in_radiance_img, nrd_texel);
+  const float4 raw_spec = imageLoad(srt.in_radiance_spec_img, nrd_texel);
+  const float4 denoised = imageLoad(srt.in_denoised_img, nrd_texel);
+  const float4 denoised_spec = imageLoad(srt.in_denoised_spec_img, nrd_texel);
+  const float3 diff_factor = aux.diff_factor.rgb;
+  const float3 spec_factor = aux.spec_factor.rgb;
+  const float3 direct_emission = aux.emission.rgb;
+  const float4 direct = imageLoad(srt.in_direct_img, texel);
+  /* Use the R32F viewZ NRD itself tests against. The fp16 copy in `direct.w` saturates to
+   * INF above ~65504 and would misclassify in-range geometry as sky on large-scale scenes
+   * (denoising range = 2x far clip), diverging from NRD's own classification. */
+  const float viewz = imageLoad(srt.in_viewz_img, nrd_texel).r;
+  const bool is_sky = abs(viewz) >= srt.denoising_range;
+  if (srt.debug_view > 0.5f) {
+    float3 debug_color = float3(0.0f);
+    const float mode = srt.debug_view;
+    if (mode < 1.5f) {
+      debug_color = ycocg_to_linear(denoised.rgb) * diff_factor;
+    }
+    else if (mode < 2.5f) {
+      debug_color = ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+    }
+    else if (mode < 3.5f) {
+      debug_color = ycocg_to_linear(raw.rgb) * diff_factor;
+    }
+    else if (mode < 4.5f) {
+      debug_color = ycocg_to_linear(raw_spec.rgb) * spec_factor;
+    }
+    else if (mode < 5.5f) {
+      debug_color = float3(raw.a);
+    }
+    else if (mode < 6.5f) {
+      debug_color = float3(raw_spec.a);
+    }
+    else if (mode < 7.5f) {
+      debug_color = ycocg_to_linear(denoised.rgb) * diff_factor +
+                     ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+    }
+    else if (mode < 8.5f) {
+      debug_color = direct.rgb + direct_emission;
+    }
+    imageStore(srt.out_composed_img, texel, float4(debug_color, 1.0f));
+    frag_out.color = float4(debug_color, 0.0f);
+    return;
+  }
+  /* RELAX classifies sky per 16x16 tile (all 256 pixels must be sky) and leaves skipped
+   * tiles unwritten (exact zeros). Near silhouettes a tile can flip between sky and mixed
+   * from frame to frame, so geometry pixels inside a skipped tile would otherwise be black.
+   * Fall back to the raw path traced radiance whenever NRD did not write the pixel. */
+  const bool denoised_valid = (denoised.x + denoised.y + denoised.z +
+                               denoised_spec.x + denoised_spec.y + denoised_spec.z) != 0.0f;
+  /* Remodulate by the per-pixel factors removed before denoising. Both raw and denoised signals
+   * use the REBLUR YCoCg encoding. */
+  float3 composed_diff = ycocg_to_linear(denoised.rgb) * diff_factor;
+  float3 composed_spec = ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+  if (srt.raw_only != 0.0f || is_sky || !denoised_valid) {
+    composed_diff = ycocg_to_linear(raw.rgb) * diff_factor;
+    composed_spec = ycocg_to_linear(raw_spec.rgb) * spec_factor;
+  }
+  /* Direct lighting bypasses the denoiser, matching the NRD sample composition. */
+  float3 radiance = float3(0.0f);
+  if (srt.use_diffuse != 0.0f) {
+    radiance += composed_diff;
+  }
+  if (srt.use_specular != 0.0f) {
+    radiance += composed_spec;
+  }
+  if (srt.use_direct != 0.0f) {
+    /* SIGMA only modulates the sun's share of the direct signal. Local lights were already
+     * shadowed by their visibility rays. */
+    const float shadow_packed = imageLoad(srt.in_shadow_img, nrd_texel).r;
+    const float shadow = (srt.raw_only != 0.0f || is_sky || !denoised_valid) ?
+                             1.0f :
+                             shadow_packed * shadow_packed;
+    const float sun_fraction = aux.diff_factor.a;
+    radiance += direct.rgb * mix(1.0f, shadow, sun_fraction);
+    /* Primary-surface emission bypasses the denoiser. */
+    radiance += direct_emission;
+  }
+  imageStore(srt.out_composed_img, texel, float4(radiance, 1.0f));
+  /* EEVEE combined alpha stores transmittance (film converts with 1-alpha), so 0 = opaque. */
+  frag_out.color = float4(radiance, 0.0f);
+}
+
+PipelineGraphic composite(composite_vert, composite_frag);
+
+}  // namespace eevee::pathtracing
diff --git a/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_debug.bsl.hh b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_debug.bsl.hh
new file mode 100644
index 00000000..6ba21de1
--- /dev/null
+++ b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_debug.bsl.hh
@@ -0,0 +1,1330 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Hardware ray tracing path tracing pass.
+ */
+
+#pragma once
+
+#include "draw_view.bsl.hh"
+#include "eevee_pathtracing_shared.hh"
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+struct Resources {
+  [[uniform(1)]] const PathTracingData &pathtracing_data;
+  [[storage(0, read)]] const InstanceRecord (&instance_buf)[];
+  [[storage(1, read)]] const PrimitiveRecord (&primitive_buf)[];
+  [[storage(2, read)]] const MaterialRecord (&material_buf)[];
+  [[storage(3, read)]] const LightRecord (&light_buf)[];
+  [[storage(4, write)]] PathTracingAux (&out_aux_buf)[];
+  [[acceleration_structure(0)]] const accelerationStructure scene_as;
+  [[image(0, write, UNORM_10_10_10_2)]] image2D out_normal_roughness_img;
+  [[image(1, write, SFLOAT_32)]] image2D out_viewz_img;
+  [[image(2, write, SFLOAT_16_16_16_16)]] image2D out_diffuse_img;
+  [[image(3, write, SFLOAT_16_16_16_16)]] image2D out_motion_img;
+  [[image(4, write, SFLOAT_16_16_16_16)]] image2D out_specular_img;
+  /* Primary-surface direct lighting (RGB), added after denoising like the NRD sample.
+   * A stores view-space Z for the composite pass. */
+  [[image(5, write, SFLOAT_16_16_16_16)]] image2D out_direct_img;
+  /* Packed sun penumbra for SIGMA. Zero when the scene has no sun. */
+  [[image(6, write, SFLOAT_16)]] image2D out_shadow_img;
+};
+
+struct PathtracingFragOut {
+  [[frag_color(0)]] float4 color;
+};
+
+float3 safe_normalize(float3 v, float3 fallback)
+{
+  float len_sq = dot(v, v);
+  if (len_sq < 1e-12f) {
+    return fallback;
+  }
+  return v * (1.0f / sqrt(len_sq));
+}
+
+/* Matches NRD's default R10G10B10A2 normal/roughness encoding. The alpha channel stores the
+ * NRD material ID in [0,1], where the NRD sample uses 0 = default, 1/3 = metal. */
+float4 pack_normal_roughness(float3 n, float roughness, float material_id)
+{
+  n /= abs(n.x) + abs(n.y) + abs(n.z);
+  float3 r;
+  r.y = n.y * 0.5f + 0.5f;
+  r.x = n.x * 0.5f + r.y;
+  r.y -= n.x * 0.5f;
+  roughness = max(roughness, 1.5f / 512.0f);
+  const float s = n.z < 0.0f ? -roughness : roughness;
+  r.z = s * 0.5f + 0.5f;
+  return float4(r, saturate(material_id / 3.0f));
+}
+
+uint hash_u32(uint x)
+{
+  x ^= x >> 16u;
+  x *= 0x7feb352du;
+  x ^= x >> 15u;
+  x *= 0x846ca68bu;
+  x ^= x >> 16u;
+  return x;
+}
+
+struct Rng {
+  uint state;
+  float next()
+  {
+    state = state * 747796405u + 2891336453u;
+    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
+    return float((word >> 22u) ^ word) * (1.0f / 4294967295.0f);
+  }
+};
+
+float3 sample_cosine_hemisphere(float u1, float u2, float3 normal)
+{
+  const float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
+  const float3 tangent = safe_normalize(cross(up, normal), float3(1.0f, 0.0f, 0.0f));
+  const float3 bitangent = cross(normal, tangent);
+  const float radius = sqrt(u1);
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return safe_normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) +
+                            normal * sqrt(max(0.0f, 1.0f - u1)),
+                        normal);
+}
+
+float3 sample_sphere_direction(float u1, float u2)
+{
+  const float z = 1.0f - 2.0f * u1;
+  const float radius = sqrt(max(0.0f, 1.0f - z * z));
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return float3(radius * cos(phi), radius * sin(phi), z);
+}
+
+float3 fresnel_schlick(float3 f0, float vdot_h)
+{
+  return f0 + (float3(1.0f) - f0) * pow(1.0f - saturate(vdot_h), 5.0f);
+}
+
+float ggx_distribution(float ndot_h, float alpha2)
+{
+  const float denom = ndot_h * ndot_h * (alpha2 - 1.0f) + 1.0f;
+  return alpha2 / max(3.14159265358979323846f * denom * denom, 1e-7f);
+}
+
+float smith_g1(float ndot_x, float alpha2)
+{
+  return 2.0f * ndot_x / max(ndot_x + sqrt(alpha2 + (1.0f - alpha2) * ndot_x * ndot_x), 1e-5f);
+}
+
+/* Height-correlated Smith masking-shadowing, G2(NoV,NoL)/G1(NoV). Replaces the separable
+ * G1(NoV)*G1(NoL) used for the VNDF weight; the separable form overestimates energy at
+ * grazing angles / rough surfaces by ~10-20% versus Cycles' correlated form. */
+float smith_lambda(float ndot_x, float alpha2)
+{
+  const float x2 = max(ndot_x * ndot_x, 1e-7f);
+  return 0.5f * (sqrt(1.0f + alpha2 * (1.0f - x2) / x2) - 1.0f);
+}
+
+float smith_g2_over_g1(float ndotv, float ndotl, float alpha2)
+{
+  const float lv = smith_lambda(ndotv, alpha2);
+  const float ll = smith_lambda(ndotl, alpha2);
+  return (1.0f + lv) / max(1.0f + lv + ll, 1e-5f);
+}
+
+float3 sample_ggx_half_vector(float u1, float u2, float3 normal, float alpha2)
+{
+  const float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
+  const float3 tangent = safe_normalize(cross(up, normal), float3(1.0f, 0.0f, 0.0f));
+  const float3 bitangent = cross(normal, tangent);
+  const float cos_theta = sqrt(max((1.0f - u1) / (1.0f + (alpha2 - 1.0f) * u1), 0.0f));
+  const float sin_theta = sqrt(max(0.0f, 1.0f - cos_theta * cos_theta));
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return safe_normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
+                            normal * cos_theta,
+                        normal);
+}
+
+/* Bounded VNDF sampling for Smith-GGX, matching NRD-Sample's
+ * ImportanceSampling::VNDF::GetRay (ML_VNDF_VERSION 3). The lobe is trimmed to 95% of its
+ * energy, as recommended for denoising. Returns the sampled half vector in world space. */
+float3 sample_ggx_vndf_half_vector(float u1,
+                                   float u2,
+                                   float3 wo,
+                                   float3 normal,
+                                   float alpha,
+                                   float alpha2)
+{
+  const float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
+  const float3 tangent = safe_normalize(cross(up, normal), float3(1.0f, 0.0f, 0.0f));
+  const float3 bitangent = cross(normal, tangent);
+
+  const float3 v_local = float3(dot(wo, tangent),
+                                dot(wo, bitangent),
+                                max(dot(wo, normal), 1e-4f));
+
+  /* The sample is warped to the hemisphere configuration around the visible normal. */
+  const float3 wi = safe_normalize(float3(alpha * v_local.xy, v_local.z),
+                                   float3(0.0f, 0.0f, 1.0f));
+  const float s = 1.0f + length(v_local.xy);
+  const float s2 = s * s;
+  const float k = (1.0f - alpha2) * s2 /
+                  max(s2 + alpha2 * v_local.z * v_local.z, 1e-7f);
+  const float b = v_local.z > 0.0f ? k * wi.z : wi.z;
+
+  const float phi = 2.0f * 3.14159265358979323846f * u1;
+  const float z = 1.0f - u2 * 0.95f * (1.0f + b);
+  const float r = sqrt(max(0.0f, 1.0f - z * z));
+  const float3 h = float3(r * cos(phi), r * sin(phi), z) + wi;
+
+  /* Warp back to the ellipsoid configuration. */
+  const float3 h_local = safe_normalize(float3(alpha * h.xy, max(h.z, 1e-6f)),
+                                        float3(0.0f, 0.0f, 1.0f));
+  return safe_normalize(
+      tangent * h_local.x + bitangent * h_local.y + normal * h_local.z, normal);
+}
+
+float max_component(float3 v)
+{
+  return max(v.x, max(v.y, v.z));
+}
+
+float luminance(float3 color)
+{
+  return dot(color, float3(0.2126f, 0.7152f, 0.0722f));
+}
+
+/* NRD-Sample's Sequence::Bayer4x4 (MathLib ml.hlsli). Returns a stable 4x4 dither in [0,1).
+ * Written with integer arithmetic so it does not need a local array. */
+float bayer4x4(uint2 sample_pos, uint frame_index)
+{
+  const uint x = sample_pos.x & 3u;
+  const uint y = sample_pos.y & 3u;
+  const uint a = 2068378560u * (1u - (x >> 1u)) + 1500172770u * (x >> 1u);
+  const uint b = (y + ((x & 1u) << 2u)) << 2u;
+  return float(((a >> b) + frame_index) & 0xFu) / 16.0f;
+}
+
+/* Luminance-preserving energy clamp. Scales RGB together instead of clipping channels,
+ * so a bright red light stays red instead of turning white. */
+float3 clamp_radiance_luminance_preserving(float3 radiance, float limit)
+{
+  if (limit <= 0.0f) {
+    return radiance;
+  }
+  const float radiance_luma = luminance(radiance);
+  if (radiance_luma > limit) {
+    return radiance * (limit / max(radiance_luma, 1e-20f));
+  }
+  return radiance;
+}
+
+/* NRD_IsValidRadiance: reject NaN/INF before accumulating into the denoiser input. */
+bool valid_radiance(float3 radiance)
+{
+  return !any(isnan(radiance)) && all(lessThan(abs(radiance), float3(1.0e30f)));
+}
+
+/* Intersect a ray with a Blender area light's emitting plane. Used for BSDF-sampled
+ * direct specular, which has much lower variance than uniform area sampling on smooth
+ * surfaces (the area light is not part of the ray traced scene). */
+bool intersect_area_light(const LightRecord light,
+                          float3 origin,
+                          float3 direction,
+                          float3 &point,
+                          float &distance)
+{
+  const float3 light_normal = light.direction_power.xyz;
+  const float denom = dot(direction, light_normal);
+  if (denom >= -1e-5f) {
+    return false;
+  }
+  const float t = dot(light.position_type.xyz - origin, light_normal) / denom;
+  if (t <= 1e-4f) {
+    return false;
+  }
+  point = origin + direction * t;
+  const float3 rel = point - light.position_type.xyz;
+  const float u = dot(rel, light.area_right.xyz);
+  const float v = dot(rel, light.area_up.xyz);
+  const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+  const uint shape = uint(light.area_right.w);
+  bool inside;
+  if (shape == 4u) {
+    inside = (u * u + v * v) <= half_size.x * half_size.x;
+  }
+  else if (shape == 5u) {
+    const float2 q = float2(u / max(half_size.x, 1e-5f), v / max(half_size.y, 1e-5f));
+    inside = dot(q, q) <= 1.0f;
+  }
+  else {
+    inside = abs(u) <= half_size.x && abs(v) <= half_size.y;
+  }
+  if (!inside) {
+    return false;
+  }
+  distance = t;
+  return true;
+}
+
+float area_light_area(const LightRecord light)
+{
+  const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+  const uint shape = uint(light.area_right.w);
+  if (shape == 4u) {
+    return 3.14159265358979323846f * half_size.x * half_size.x;
+  }
+  if (shape == 5u) {
+    return 3.14159265358979323846f * half_size.x * half_size.y;
+  }
+  return 4.0f * half_size.x * half_size.y;
+}
+
+/* Approximation from "Ray Tracing Gems" chapter 32, identical to NRD's environment term. */
+float3 nrd_environment_term(float3 rf0, float no_v, float roughness)
+{
+  const float m = saturate(roughness * roughness);
+  const float4 x = float4(1.0f, no_v, no_v * no_v, no_v * no_v * no_v);
+  const float4 y = float4(1.0f, m, m * m, m * m * m);
+
+  const float bias_num = (0.99044f * x.x + 1.29678f * x.y) * y.x +
+                         (-1.28514f * x.x - 0.755907f * x.y) * y.y;
+  const float bias_den = (1.0f * x.x + 20.3225f * x.y + 121.563f * x.w) * y.x +
+                         (2.92338f * x.x - 27.0302f * x.y + 626.13f * x.w) * y.y +
+                         (59.4188f * x.x + 222.592f * x.y + 316.627f * x.w) * y.w;
+  const float scale_num = (0.0365463f * x.x + 9.0632f * x.y) * y.x +
+                          (3.32707f * x.x - 9.04756f * x.y) * y.y;
+  const float scale_den = (1.0f * x.x + 9.04401f * x.z + 5.56589f * x.w) * y.x +
+                          (3.59685f * x.x - 16.3174f * x.z + 19.7886f * x.w) * y.y +
+                          (-1.36772f * x.x + 9.22949f * x.z - 20.2123f * x.w) * y.w;
+
+  const float bias = bias_num / max(bias_den, 1e-6f);
+  const float scale = scale_num / max(scale_den, 1e-6f);
+  return saturate(rf0 * scale + bias);
+}
+
+/* Matches NRD's NRD_MaterialFactors: removes the primary surface BRDF from the denoiser
+ * input. The same factors are re-applied in the composite pass. */
+void nrd_material_factors(float3 n,
+                          float3 v,
+                          float3 albedo,
+                          float3 rf0,
+                          float roughness,
+                          float3 &diff_factor,
+                          float3 &spec_factor)
+{
+  const float3 f_env = nrd_environment_term(rf0, abs(dot(n, v)), roughness);
+  diff_factor = mix(float3(0.02f), float3(1.0f), (float3(1.0f) - f_env) * albedo);
+  spec_factor = f_env * mix(0.1f, 1.0f, roughness);
+  spec_factor = mix(float3(0.02f), float3(1.0f), spec_factor);
+}
+
+/* REBLUR works in YCoCg space. The denoiser input radiance must be converted on the way in and
+ * the denoised output must be converted back on the way out (NRD_Sample uses
+ * REBLUR_FrontEnd_PackRadianceAndNormHitDist and REBLUR_BackEnd_UnpackRadianceAndNormHitDist).
+ * Feeding linear RGB to REBLUR (as RELAX expects) silently shifts the hue, e.g. neutral grey
+ * surfaces turn pink. */
+float3 linear_to_ycocg(float3 color)
+{
+  const float y = dot(color, float3(0.25f, 0.5f, 0.25f));
+  const float co = dot(color, float3(0.5f, 0.0f, -0.5f));
+  const float cg = dot(color, float3(-0.25f, 0.5f, -0.25f));
+  return float3(y, co, cg);
+}
+
+float3 ycocg_to_linear(float3 color)
+{
+  const float t = color.x - color.z;
+  return max(float3(t + color.y, color.x + color.z, t - color.y), float3(0.0f));
+}
+
+/* Matches NRD 4.18's _REBLUR_GetHitDistanceNormalization with the default
+ * ReblurHitDistanceParameters (A = 3, B = 0.1, C = 20):
+ *   smc = (1 - exp2(-200 * roughness^2)) * sqrt(saturate(roughness))
+ *   scale = (A + |viewZ| * B) * lerp(C, 1, smc)
+ * REBLUR expects the hit distance normalized to [0, 1] in the alpha channel of
+ * IN_DIFF_RADIANCE_HITDIST / IN_SPEC_RADIANCE_HITDIST. */
+float reblur_norm_hit_distance(float hit_distance, float view_z, float roughness)
+{
+  const float r = saturate(roughness);
+  const float smc = (1.0f - exp2(-200.0f * r * r)) * sqrt(r);
+  const float scale = (3.0f + abs(view_z) * 0.1f) * mix(20.0f, 1.0f, smc);
+  return saturate(hit_distance / max(scale, 1e-4f));
+}
+
+/* NRD-Sample's EstimateDiffuseProbability: lobe selection probability from the approximate
+ * environment Fresnel term. This is what gives dielectric surfaces their specular reflections
+ * while keeping metals fully specular. */
+float estimate_diffuse_probability(float3 albedo, float3 rf0, float no_v, float roughness)
+{
+  const float3 f_env = nrd_environment_term(rf0, no_v, roughness);
+  const float lum_spec = dot(f_env, float3(0.2126f, 0.7152f, 0.0722f));
+  const float lum_diff = dot(albedo * (float3(1.0f) - f_env),
+                             float3(0.2126f, 0.7152f, 0.0722f));
+  const float diff_prob = lum_diff / max(lum_diff + lum_spec, 1e-5f);
+  /* NRD-Sample: clamp to [1/20, 19/20] to limit firefly energy, but keep exact 0/1 for
+   * pure metals and pure diffuse surfaces (PT_EVIL_TWIN_LOBE_TOLERANCE). */
+  if (diff_prob < 0.005f) {
+    return 0.0f;
+  }
+  if (diff_prob > 0.995f) {
+    return 1.0f;
+  }
+  return clamp(diff_prob, 0.05f, 0.95f);
+}
+
+/* NRD-Sample's "magic boost": high-roughness surfaces are treated as more diffuse-like for
+ * temporal/hit-distance weighting. This is deliberately not used for the actual lobe choice,
+ * matching the reference. */
+float estimate_diffuse_probability_biased(float3 albedo,
+                                          float3 rf0,
+                                          float no_v,
+                                          float roughness)
+{
+  float diff_prob = estimate_diffuse_probability(albedo, rf0, no_v, roughness);
+  diff_prob = mix(diff_prob, 1.0f, pow(saturate(roughness), 0.5f));
+  return clamp(diff_prob, 0.05f, 0.95f);
+}
+
+/* Transform a world-space hit into the object's previous world transform. */
+float3 to_previous_world(const InstanceRecord instance, float3 world_position)
+{
+  const float4 local = inverse(instance.object_to_world) * float4(world_position, 1.0f);
+  return (instance.prev_object_to_world * local).xyz;
+}
+
+bool project_screen_uv(const float4x4 world_to_view,
+                       const float4x4 view_to_clip,
+                       float3 world_position,
+                       float2 &uv)
+{
+  const float4 clip = view_to_clip * (world_to_view * float4(world_position, 1.0f));
+  if (clip.w <= 1e-6f) {
+    return false;
+  }
+  uv = clip.xy / clip.w * 0.5f + 0.5f;
+  return uv.x >= 0.0f && uv.x < 1.0f && uv.y >= 0.0f && uv.y < 1.0f;
+}
+
+/* Same projection as project_screen_uv but without the [0,1] in-screen clamp. A pixel that
+ * just entered the screen has an out-of-range prev_uv (e.g. -0.03); clamping it to zero made
+ * NRD think it did not move and reuse stale history from the screen edge. */
+bool project_screen_uv_unbounded(const float4x4 world_to_view,
+                                 const float4x4 view_to_clip,
+                                 float3 world_position,
+                                 float2 &uv)
+{
+  const float4 clip = view_to_clip * (world_to_view * float4(world_position, 1.0f));
+  if (clip.w <= 1e-6f) {
+    return false;
+  }
+  uv = clip.xy / clip.w * 0.5f + 0.5f;
+  return true;
+}
+
+bool previous_screen_uv(const PathTracingData data, float3 prev_world_position, float2 &uv)
+{
+  return project_screen_uv(
+      data.prev_world_to_view, data.prev_view_to_clip, prev_world_position, uv);
+}
+
+[[vertex]] void vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void frag([[frag_coord]] const float4 frag_co,
+                       [[resource_table]] Resources &srt,
+                       [[resource_table]] const draw::View &views,
+                       [[out]] PathtracingFragOut &frag_out)
+{
+  const float2 resolution = float2(srt.pathtracing_data.resolution);
+  /* The render view already contains the film's sub-pixel jitter. Adding the sample jitter here
+   * again would double-jitter the rays and desynchronize them from the motion vectors. */
+  const float2 screen_uv = frag_co.xy / resolution;
+
+  const ViewMatrices view = views.get(0);
+  const float3 near_point = view.point_screen_to_world(float3(screen_uv, 0.0f));
+  const float3 far_point = view.point_screen_to_world(float3(screen_uv, 1.0f));
+
+  Rng rng;
+  rng.state = hash_u32(uint(frag_co.x) + uint(frag_co.y) * uint(resolution.x) +
+                       srt.pathtracing_data.sample_index * 9781u);
+
+  /* Trace the primary camera ray ONCE and share the hit with both lobes. Previously each lobe
+   * re-traced the same primary ray and re-evaluated the same SSBO lookup, inverse matrix and
+   * direct lighting. Now the primary intersection and its direct light are computed once; the
+   * lobe loop below only walks the indirect path starting at bounce 1. */
+  const float3 primary_ray_origin = near_point;
+  const float3 primary_ray_direction = safe_normalize(far_point - near_point,
+                                                      float3(0.0f, 0.0f, -1.0f));
+
+  float3 radiance = float3(0.0f);
+  float3 diff_radiance = float3(0.0f);
+  float3 spec_radiance = float3(0.0f);
+  float3 direct_radiance = float3(0.0f);
+  float3 sun_direct_radiance = float3(0.0f);
+  bool has_sun = false;
+  float3 sun_direction = float3(0.0f, 0.0f, 1.0f);
+  float tan_sun_radius = 0.0f;
+  float sun_penumbra = 1.0e30f;
+
+  float3 nrd_normal = float3(0.0f, 0.0f, 1.0f);
+  float nrd_material_id = 0.0f;
+  float nrd_roughness = 1.0f;
+  float nrd_viewz = uintBitsToFloat(0xFF800000u);
+  float diff_hitdist = 0.0f;
+  float spec_hitdist = 0.0f;
+  float3 primary_hit_position = float3(0.0f);
+  float3 primary_prev_hit_position = float3(0.0f);
+  bool primary_hit = false;
+  float3 diff_factor = float3(1.0f);
+  float3 spec_factor = float3(1.0f);
+  float3 primary_emission = float3(0.0f);
+
+  const float3 background = srt.pathtracing_data.background.rgb;
+  const float inv_pi = 0.3183098861837907f;
+  const uint max_bounces = max(srt.pathtracing_data.max_bounces, 1u);
+  const uint debug_flags = srt.pathtracing_data.pad0;
+
+  /* --------------------------------------------------------
+   * 1. Trace primary camera ray ONCE (shared by both lobes).
+   * -------------------------------------------------------- */
+  rayQuery primary_query;
+  rayQueryInitialize(primary_query,
+                     srt.scene_as,
+                     gpu_RayFlagsNone,
+                     0xFFu,
+                     primary_ray_origin,
+                     1e-4f,
+                     primary_ray_direction,
+                     1e30f);
+  while (rayQueryProceed(primary_query)) {
+  }
+
+  bool primary_valid = false;
+  InstanceRecord p_instance;
+  MaterialRecord p_material;
+  float3 p_normal = float3(0.0f, 0.0f, 1.0f);
+  float3 p_offset_normal = float3(0.0f, 0.0f, 1.0f);
+  float p_ray_epsilon = 1e-4f;
+  float p_curvature = 0.0f;
+  float p_roughness = 1.0f;
+  float3 p_diffuse_color = float3(0.0f);
+  float3 p_f0 = float3(0.04f);
+  float p_alpha = 1.0f;
+  float p_alpha2 = 1.0f;
+  float3 p_wo = -primary_ray_direction;
+  float p_ndotv = 1.0f;
+
+  if (rayQueryGetIntersectionType(primary_query, true) != gpu_RayQueryCommittedIntersectionNone) {
+    const uint instance_id = rayQueryGetIntersectionInstanceCustomIndex(primary_query, true);
+    const uint primitive_index = rayQueryGetIntersectionPrimitiveIndex(primary_query, true);
+    if (instance_id < srt.pathtracing_data.instance_count) {
+      p_instance = srt.instance_buf[instance_id];
+      const uint primitive_id = p_instance.primitive_offset + primitive_index;
+      if (primitive_id < srt.pathtracing_data.primitive_count) {
+        const PrimitiveRecord primitive = srt.primitive_buf[primitive_id];
+        if (primitive.material_id < srt.pathtracing_data.material_count) {
+          p_material = srt.material_buf[primitive.material_id];
+          primary_valid = true;
+
+          const float hit_distance = rayQueryGetIntersectionT(primary_query, true);
+          const float3 hit_position = primary_ray_origin + primary_ray_direction * hit_distance;
+
+          const float3x3 object_matrix = float3x3(p_instance.object_to_world[0].xyz,
+                                                  p_instance.object_to_world[1].xyz,
+                                                  p_instance.object_to_world[2].xyz);
+          const float3x3 normal_matrix = transpose(inverse(object_matrix));
+          const float3 geometric_normal = safe_normalize(normal_matrix * primitive.normal.xyz,
+                                                         float3(0.0f, 0.0f, 1.0f));
+          const bool front_face = dot(geometric_normal, primary_ray_direction) < 0.0f;
+          const float2 bary = rayQueryGetIntersectionBarycentrics(primary_query, true);
+          const float3 bary3 = float3(1.0f - bary.x - bary.y, bary.x, bary.y);
+          float3 shading_normal = (normal_matrix * primitive.normal0.xyz) * bary3.x +

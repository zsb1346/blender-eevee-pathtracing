+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Optional NVIDIA NRD denoiser bridge for the Vulkan backend.
+ */
+
+#pragma once
+
+#include "GPU_texture.hh"
+
+namespace blender::gpu {
+
+struct NrdDenoiseInput {
+  Texture *color = nullptr;
+  Texture *specular = nullptr;
+  Texture *normal_roughness = nullptr;
+  Texture *viewz = nullptr;
+  Texture *motion = nullptr;
+  Texture *output = nullptr;
+  Texture *output_specular = nullptr;
+  int width = 0;
+  int height = 0;
+  float view_z_scale = 1.0f;
+  float denoising_range = 1e6f;
+  /* Camera jitter in pixels, in [-0.5, 0.5], as expected by NRD. */
+  float camera_jitter[2] = {0.0f, 0.0f};
+  float camera_jitter_prev[2] = {0.0f, 0.0f};
+  bool reset_history = false;
+  const float *view_to_clip = nullptr;
+  const float *world_to_view = nullptr;
+};
+
+bool nrd_denoise(const NrdDenoiseInput &input);
+
+}  // namespace blender::gpu

+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Path tracing scene data and the M1 debug hit pass.
+ */
+
+#pragma once
+
+#include "BLI_map.hh"
+#include "BLI_vector.hh"
+
+#include "DRW_gpu_wrapper.hh"
+#include "GPU_index_buffer.hh"
+#include "GPU_ray_tracing.hh"
+#include "GPU_shader.hh"
+#include "GPU_vertex_buffer.hh"
+#include "draw_pass.hh"
+
+#include "eevee_pathtracing_shared.hh"
+
+struct Object;
+struct Mesh;
+
+namespace blender::eevee {
+
+class Instance;
+
+class PathTracingModule {
+ private:
+  struct ObjectGeometry {
+    gpu::BottomLevelASPtr blas;
+    gpu::VertBufPtr vertex_buffer;
+    gpu::IndexBufPtr index_buffer;
+    const Mesh *mesh = nullptr;
+    const void *positions = nullptr;
+    const void *corner_tris = nullptr;
+  };
+
+  Instance &inst_;
+
+  bool enabled_ = false;
+
+  gpu::TopLevelASPtr tlas_;
+  Map<const Object *, ObjectGeometry> geometry_;
+
+  draw::UniformBuffer<PathTracingData> data_buf_{"PathTracingData"};
+  draw::StorageArrayBuffer<InstanceRecord, 1> instance_buf_{"PathTracingInstanceBuf"};
+  draw::StorageArrayBuffer<PrimitiveRecord, 1> primitive_buf_{"PathTracingPrimitiveBuf"};
+  draw::StorageArrayBuffer<MaterialRecord, 1> material_buf_{"PathTracingMaterialBuf"};
+  draw::StorageArrayBuffer<LightRecord, 1> light_buf_{"PathTracingLightBuf"};
+
+  Vector<InstanceRecord> instances_;
+  Vector<PrimitiveRecord> primitives_;
+  Vector<MaterialRecord> materials_;
+  Vector<LightRecord> lights_;
+
+  float4x4 prev_world_to_view_;
+  float4x4 prev_view_to_clip_;
+  bool has_prev_ = false;
+
+  /* Object transforms keyed by object index and instance, for object motion vectors.
+   * `current_` is filled during sync and becomes `prev_` after the frame is submitted, so
+   * `prev_` always matches the last rendered frame even if sync runs multiple times. */
+  Map<uint64_t, float4x4> prev_object_to_world_;
+  Map<uint64_t, float4x4> current_object_to_world_;
+
+  /* NRD history is preserved across object edits. It is reset for a new session, a
+   * resolution change, a non-sequential still render, or a viewport sampling reset. The
+   * last case covers camera navigation: EEVEE clears its sampling state before the draw
+   * pass, so `end_sync()` records it here for the following `render()`. */
+  bool nrd_session_started_ = false;
+  int2 nrd_extent_ = int2(0);
+  int last_render_frame_ = -1;
+  bool history_reset_pending_ = false;
+  float2 prev_jitter_ = float2(0.0f);
+
+  /* Final temporal accumulation, following the NRD-Sample TAA pass. The composite writes its
+   * result to `taa_composed_tx_`, and TAA resolves it into the render result while storing the
+   * history in one of two ping-pong textures. */
+  draw::Texture taa_composed_tx_ = {"PathTracingTAAComposed"};
+  draw::Texture taa_history_a_tx_ = {"PathTracingTAAHistoryA"};
+  draw::Texture taa_history_b_tx_ = {"PathTracingTAAHistoryB"};
+  gpu::Texture *taa_history_prev_tx_ = nullptr;
+  gpu::Texture *taa_history_next_tx_ = nullptr;
+  uint taa_history_index_ = 0;
+  bool taa_history_valid_ = false;
+
+  draw::PassMain pass_{"PathTracing.Debug"};
+  gpu::StaticShader shader_{"eevee_pathtracing_debug"};
+
+  draw::PassSimple composite_pass_{"PathTracing.Composite"};
+  gpu::StaticShader composite_shader_{"eevee_pathtracing_composite"};
+
+  draw::PassSimple taa_pass_{"PathTracing.TAA"};
+  gpu::StaticShader taa_shader_{"eevee_pathtracing_taa"};
+
+ public:
+  PathTracingModule(Instance &inst) : inst_(inst) {}
+
+  void begin_sync();
+  void object_sync(draw::ObjectRef &ob_ref);
+  void end_sync();
+  void render(draw::View &view,
+              draw::View &main_view,
+              draw::Framebuffer &combined_fb,
+              const float2 &camera_jitter);
+
+  bool enabled() const
+  {
+    return enabled_;
+  }
+
+ private:
+  void light_sync(draw::ObjectRef &ob_ref);
+};
+
+}  // namespace blender::eevee

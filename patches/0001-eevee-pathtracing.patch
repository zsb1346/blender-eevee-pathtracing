+        }
+      }
+    }
+
+    /* --------------------------------------------------------
+     * 3. Indirect diffuse & specular/transmission lobes starting from bounce = 1.
+     * -------------------------------------------------------- */
+    for (uint lobe = 0u; lobe < 2u; lobe++) {
+      const bool primary_specular = (lobe == 1u);
+      float3 wi0;
+      float3 brdf_weight0 = float3(0.0f);
+      float3 ray_origin = primary_hit_position + p_offset_normal * p_ray_epsilon;
+
+      if (primary_specular) {
+        const float total_st = spec_weight_sum + transmit_weight_sum;
+        if (total_st <= 1e-6f) {
+          continue;
+        }
+        const float prob_refl = spec_weight_sum / total_st;
+        if (rng.next() < prob_refl) {
+          const float3 half_vector = sample_ggx_vndf_half_vector(
+              rng.next(), rng.next(), p_wo, p_spec_N, p_spec_alpha, p_spec_alpha2);
+          wi0 = reflect(primary_ray_direction, half_vector);
+          const float ndotl = dot(p_spec_N, wi0);
+          if (ndotl <= 0.0f) {
+            continue;
+          }
+          brdf_weight0 = p_spec_color * smith_g2_over_g1(p_spec_ndotv, ndotl, p_spec_alpha2) /
+                         max(prob_refl, 1e-3f);
+        }
+        else {
+          const float prob_trans = max(1.0f - prob_refl, 1e-3f);
+          if (p_transmit_type == 1u) {
+            const float t_alpha = p_transmit_roughness * p_transmit_roughness;
+            const float3 half_vector = sample_ggx_vndf_half_vector(
+                rng.next(), rng.next(), p_wo, p_transmit_N, t_alpha, t_alpha * t_alpha);
+            wi0 = refract(primary_ray_direction, half_vector, 1.0f / p_transmit_ior);
+            if (dot(wi0, wi0) < 1e-4f) {
+              wi0 = reflect(primary_ray_direction, half_vector);
+            }
+            else {
+              ray_origin = primary_hit_position - p_offset_normal * p_ray_epsilon;
+            }
+            brdf_weight0 = p_transmit_color / prob_trans;
+          }
+          else if (p_transmit_type == 2u) {
+            const float t_alpha = p_transmit_roughness * p_transmit_roughness;
+            const float3 half_vector = sample_ggx_vndf_half_vector(
+                rng.next(), rng.next(), p_wo, p_transmit_N, t_alpha, t_alpha * t_alpha);
+            wi0 = refract(primary_ray_direction, half_vector, 1.0f);
+            ray_origin = primary_hit_position - p_offset_normal * p_ray_epsilon;
+            brdf_weight0 = p_transmit_color / prob_trans;
+          }
+          else {
+            wi0 = sample_cosine_hemisphere(rng.next(), rng.next(), -p_transmit_N);
+            ray_origin = primary_hit_position - p_offset_normal * p_ray_epsilon;
+            brdf_weight0 = p_transmit_color / prob_trans;
+          }
+        }
+      }
+      else {
+        if (diff_weight_sum <= 1e-6f) {

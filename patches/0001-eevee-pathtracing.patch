+    /* BSDF-sampled direct specular with Power-Heuristic MIS for area lights -> REBLUR. */
+    if ((debug_flags & 4u) == 0u && spec_weight_sum > 1e-6f) {
+      for (uint light_id = 0u; light_id < srt.pathtracing_data.light_count; light_id++) {

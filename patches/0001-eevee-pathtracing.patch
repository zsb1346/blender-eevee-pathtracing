index 0000000000000000000000000000000000000000..2d7e9c558bd03b40c852a013aa1bdf26cc26342b
--- /dev/null
+++ b/source/blender/draw/engines/eevee/shaders/eevee_pathtracing_composite.bsl.hh
@@ -0,0 +1,137 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Composites the denoised path tracing result with the raw radiance for sky pixels.
+ *
+ * NRD denoisers do not write output pixels outside of the denoising range (sky).
+ * For those pixels the raw path traced radiance must be used instead, matching
+ * the reference composition in the NRD sample.
+ */
+
+#pragma once
+
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+struct CompositeResources {
+  /* Raw indirect path traced radiance (RGB) and path hit distance (A). */
+  [[image(0, read, SFLOAT_16_16_16_16)]] const image2D in_radiance_img;
+  /* NRD denoised indirect radiance (RGB). */
+  [[image(1, read, SFLOAT_16_16_16_16)]] const image2D in_denoised_img;
+  /* NRD denoised specular indirect radiance (RGB). */
+  [[image(2, read, SFLOAT_16_16_16_16)]] const image2D in_denoised_spec_img;
+  /* Raw specular indirect path traced radiance (RGB) and path hit distance (A). */
+  [[image(3, read, SFLOAT_16_16_16_16)]] const image2D in_radiance_spec_img;
+  /* Demodulation factors stored by the path tracing pass. */
+  [[image(4, read, SFLOAT_16_16_16_16)]] const image2D in_diff_factor_img;
+  [[image(5, read, SFLOAT_16_16_16_16)]] const image2D in_spec_factor_img;
+  /* Primary-surface direct lighting (RGB). A stores linear view-space Z, negative for
+   * Blender's right-handed view space. */
+  [[image(6, read, SFLOAT_16_16_16_16)]] const image2D in_direct_img;
+  /* Must match the denoising range passed to NRD. */
+  [[push_constant]] const float denoising_range;
+  /* Debug path: bypass the denoised inputs and use the raw path traced signal. */
+  [[push_constant]] const float raw_only;
+  /* Debug channel selector. 0 = normal composition. */
+  [[push_constant]] const float debug_view;
+  /* Channel toggles for the final composition. */
+  [[push_constant]] const float use_direct;
+  [[push_constant]] const float use_diffuse;
+  [[push_constant]] const float use_specular;
+  /* Composite result for the final TAA pass. A stores 1 for written pixels. */
+  [[image(7, write, SFLOAT_16_16_16_16)]] image2D out_composed_img;
+};
+
+/* REBLUR operates in YCoCg space: the path tracing pass encodes its denoiser input and writes the
+ * denoised output in the same encoding. Convert back to linear before remodulating. */
+float3 ycocg_to_linear(float3 color)
+{
+  const float t = color.x - color.z;
+  return max(float3(t + color.y, color.x + color.z, t - color.y), float3(0.0f));
+}
+
+[[vertex]] void composite_vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void composite_frag([[frag_coord]] const float4 frag_co,
+                                 [[resource_table]] CompositeResources &srt)
+{
+  const int2 texel = int2(frag_co.xy);
+  const float4 raw = imageLoad(srt.in_radiance_img, texel);
+  const float4 raw_spec = imageLoad(srt.in_radiance_spec_img, texel);
+  const float4 denoised = imageLoad(srt.in_denoised_img, texel);
+  const float4 denoised_spec = imageLoad(srt.in_denoised_spec_img, texel);
+  const float3 diff_factor = imageLoad(srt.in_diff_factor_img, texel).rgb;
+  const float3 spec_factor = imageLoad(srt.in_spec_factor_img, texel).rgb;
+  const float4 direct = imageLoad(srt.in_direct_img, texel);
+  const float viewz = direct.w;
+  const bool is_sky = abs(viewz) >= srt.denoising_range;
+  if (srt.debug_view > 0.5f) {
+    float3 debug_color = float3(0.0f);
+    const float mode = srt.debug_view;
+    if (mode < 1.5f) {
+      debug_color = ycocg_to_linear(denoised.rgb) * diff_factor;
+    }
+    else if (mode < 2.5f) {
+      debug_color = ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+    }
+    else if (mode < 3.5f) {
+      debug_color = ycocg_to_linear(raw.rgb) * diff_factor;
+    }
+    else if (mode < 4.5f) {
+      debug_color = ycocg_to_linear(raw_spec.rgb) * spec_factor;
+    }
+    else if (mode < 5.5f) {
+      debug_color = float3(raw.a);
+    }
+    else if (mode < 6.5f) {
+      debug_color = float3(raw_spec.a);
+    }
+    else if (mode < 7.5f) {
+      debug_color = ycocg_to_linear(denoised.rgb) * diff_factor +
+                     ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+    }
+    else if (mode < 8.5f) {
+      debug_color = direct.rgb;
+    }
+    imageStore(srt.out_composed_img, texel, float4(debug_color, 1.0f));
+    return;
+  }
+  /* RELAX classifies sky per 16x16 tile (all 256 pixels must be sky) and leaves skipped
+   * tiles unwritten (exact zeros). Near silhouettes a tile can flip between sky and mixed
+   * from frame to frame, so geometry pixels inside a skipped tile would otherwise be black.
+   * Fall back to the raw path traced radiance whenever NRD did not write the pixel. */
+  const bool denoised_valid = (denoised.x + denoised.y + denoised.z +
+                               denoised_spec.x + denoised_spec.y + denoised_spec.z) != 0.0f;
+  /* Remodulate by the per-pixel factors removed before denoising. Both raw and denoised signals
+   * use the REBLUR YCoCg encoding. */
+  float3 composed_diff = ycocg_to_linear(denoised.rgb) * diff_factor;
+  float3 composed_spec = ycocg_to_linear(denoised_spec.rgb) * spec_factor;
+  if (srt.raw_only != 0.0f || is_sky || !denoised_valid) {
+    composed_diff = ycocg_to_linear(raw.rgb) * diff_factor;
+    composed_spec = ycocg_to_linear(raw_spec.rgb) * spec_factor;
+  }
+  /* Direct lighting bypasses the denoiser, matching the NRD sample composition. */
+  float3 radiance = float3(0.0f);
+  if (srt.use_diffuse != 0.0f) {
+    radiance += composed_diff;
+  }
+  if (srt.use_specular != 0.0f) {
+    radiance += composed_spec;
+  }
+  if (srt.use_direct != 0.0f) {
+    radiance += direct.rgb;
+  }
+  imageStore(srt.out_composed_img, texel, float4(radiance, 1.0f));
+}
+
+PipelineGraphic composite(composite_vert, composite_frag);
+
+}  // namespace eevee::pathtracing

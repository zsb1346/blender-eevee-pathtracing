+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Shared path tracing scene data between host and shader code.
+ */
+
+#pragma once
+
+#include "GPU_shader_shared_utils.hh"
+
+#ifndef GPU_SHADER
+namespace blender::eevee {
+#endif
+
+struct [[host_shared]] PathTracingData {
+  uint2 resolution;
+  uint instance_count;
+  uint primitive_count;
+  uint material_count;
+  uint light_count;
+  uint sample_index;
+  uint pad0;
+  float4 background;
+  float4x4 prev_world_to_view;
+  float4x4 prev_view_to_clip;
+  /* Un-jittered current-frame view matrices (from main_view), matching the NRD matrices.
+   * Motion vectors are built by projecting the primary hit with these two matrices rather
+   * than by subtracting per-frame jitter from the jittered view matrices. */
+  float4x4 curr_world_to_view;
+  float4x4 curr_view_to_clip;
+  uint max_bounces;
+  float clamp_direct;
+  float clamp_indirect;
+  /* Non-zero when the TAA history texture contains a valid previous frame. */
+  uint taa_history_valid;
+  /* Sub-pixel camera jitters of the current and previous frame, in render pixels. */
+  float2 curr_jitter;
+  float2 prev_jitter;
+  float2 pad1;
+  float2 pad2;
+};
+
+struct [[host_shared]] InstanceRecord {
+  float4x4 object_to_world;
+  /* Object transform at the previous frame, used for object motion vectors and history
+   * reprojection. Equal to `object_to_world` for static objects or on the first frame. */
+  float4x4 prev_object_to_world;
+  uint primitive_offset;
+  uint primitive_count;
+  uint material_table_offset;
+  uint object_id;
+  uint visibility_mask;
+  uint flags;
+  uint pad0;
+  uint pad1;
+};
+
+struct [[host_shared]] PrimitiveRecord {
+  float4 normal;
+  float4 normal0;
+  float4 normal1;
+  float4 normal2;
+  uint material_id;
+  uint object_id;
+  uint geometry_index;
+  uint flags;
+  float area;
+  uint uv_layer_offset;
+  uint attribute_offset;
+  uint pad0;
+};
+
+struct [[host_shared]] MaterialRecord {
+  float4 base_color;
+  /* x = roughness, y = metallic, zw = reserved. */
+  float4 params;
+  /* rgb = emission radiance (emission color * strength), a = reserved. */
+  float4 emission;
+  uint closure_offset;
+  uint closure_count;
+  uint texture_offset;
+  uint object_info_offset;
+  uint aov_offset;
+  uint flags;
+  uint pad0;
+  uint pad1;
+};
+
+/* Per-pixel values that do not fit in the eight BSL image slots. The path tracing pass writes
+ * these through an SSBO and the composite pass reads them back. */
+struct [[host_shared]] PathTracingAux {
+  float4 diff_factor;
+  float4 spec_factor;
+  /* Primary-surface emission. Kept out of the denoiser inputs so emissive surfaces
+   * stay sharp; added back in the composite pass. */
+  float4 emission;
+};
+
+struct [[host_shared]] LightRecord {
+  /* xyz = world position, w = light type (eLightType). */
+  float4 position_type;
+  /* xyz = world forward direction, w = power / sun strength. */
+  float4 direction_power;
+  /* rgb = light color, a = point/spot radius. */
+  float4 color_radius;
+  /* x = spot size, y = spot blend, z = area size X, w = area size Y. */
+  float4 spot_flags;
+  /* xyz = area light local X axis in world, w = eLightAreaShape. */
+  float4 area_right;
+  /* xyz = area light local Y axis in world, w = pad. */
+  float4 area_up;
+};
+
+#ifndef GPU_SHADER
+}  // namespace blender::eevee
+#endif

+              local = (uv * 2.0f - 1.0f) * half_size;
+            }
+            light_position += light.area_right.xyz * local.x + light.area_up.xyz * local.y;
+            const float3 to_light = light_position - hit_position;
+            const float distance_sq = dot(to_light, to_light);
+            const float distance = sqrt(distance_sq);
+            wi_l = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+            const float cos_light = saturate(dot(-wi_l, light.direction_power.xyz));
+            if (cos_light <= 0.0f) {
+              continue;
+            }
+            irradiance = light.color_radius.rgb * light.direction_power.w * cos_light /
+                         max(3.14159265358979323846f * distance_sq, 1e-3f);
+            shadow_distance = distance;
+          }
+          else {
+            const float3 to_light = light.position_type.xyz - hit_position;
+            const float distance_sq = dot(to_light, to_light);
+            const float distance = sqrt(distance_sq);
+            wi_l = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+            const float min_distance_sq = max(light.color_radius.a * light.color_radius.a, 1e-4f);
+            irradiance = light.color_radius.rgb * light.direction_power.w /
+                         max(4.0f * 3.14159265358979323846f * max(distance_sq, min_distance_sq),
+                             1e-3f);
+            shadow_distance = distance;
+            if (light_type == 2u) {
+              const float cos_angle = dot(-wi_l, light.direction_power.xyz);
+              const float outer_angle = light.spot_flags.x * 0.5f;
+              const float inner_angle = outer_angle * (1.0f - light.spot_flags.y);
+              const float cos_outer = cos(outer_angle);
+              const float cos_inner = cos(inner_angle);
+              if (cos_angle < cos_outer) {
+                continue;
+              }
+              irradiance *= saturate((cos_angle - cos_outer) / max(cos_inner - cos_outer, 1e-5f));
+            }
+          }
+
+          const float ndotl = max(dot(normal, wi_l), 0.0f);
+          if (ndotl <= 0.0f || shadow_distance <= ray_epsilon) {
+            continue;
+          }
+
+          rayQuery shadow_query;
+          rayQueryInitialize(shadow_query,
+                             srt.scene_as,
+                             gpu_RayFlagsTerminateOnFirstHit,
+                             0xFFu,
+                             hit_position + offset_normal * ray_epsilon,
+                             ray_epsilon,
+                             wi_l,
+                             max(shadow_distance - ray_epsilon, 0.0f));
+          while (rayQueryProceed(shadow_query)) {
+          }
+          if (rayQueryGetIntersectionType(shadow_query, true) !=
+              gpu_RayQueryCommittedIntersectionNone)
+          {
+            continue;
+          }
+
+          const float3 h_vec = wi_l + wo;
+          const float3 half_vector = (dot(h_vec, h_vec) > 1e-8f) ? safe_normalize(h_vec, normal) :
+                                                                   normal;
+          const float ndoth = saturate(dot(normal, half_vector));
+          const float vdoth = saturate(dot(wo, half_vector));
+          const float3 fresnel = fresnel_schlick(f0, vdoth);
+          const float distribution = ggx_distribution(ndoth, alpha2);
+          const float geometry = smith_g1(ndotv, alpha2) * smith_g1(ndotl, alpha2);
+          const float3 specular = (distribution * geometry) * fresnel /
+                                  max(4.0f * ndotl * ndotv, 1e-4f);
+          const float3 direct_diffuse = irradiance * ndotl * diffuse_color * inv_pi *
+                                        (1.0f - fresnel);
+          const float3 contribution = clamp_radiance_luminance_preserving(
+              throughput * (direct_diffuse + irradiance * ndotl * specular),
+              srt.pathtracing_data.clamp_indirect);
+          if (valid_radiance(contribution)) {
+            bounce_radiance += contribution;
+            if (primary_specular) {
+              spec_radiance += contribution;
+            }
+            else {
+              diff_radiance += contribution;
+            }
+          }
+        }
+
+        /* Next bounce lobe selection. */
+        float diffuse_probability = estimate_diffuse_probability(
+            diffuse_color, f0, ndotv, roughness);
+        float rnd = rng.next();
+        if (bounce == 1u) {
+          diffuse_probability = (diffuse_probability != 0.0f) ?
+                                    clamp(diffuse_probability, 0.25f, 0.75f) :
+                                    0.0f;
+          rnd = bayer4x4(uint2(uint(frag_co.x), uint(frag_co.y)),
+                         srt.pathtracing_data.sample_index) +
+                rnd / 16.0f;
+        }
+        const bool sample_specular = rnd >= diffuse_probability;
+
+        float3 wi;
+        float3 brdf_weight;
+        if (sample_specular) {
+          const float3 half_vector = sample_ggx_vndf_half_vector(
+              rng.next(), rng.next(), wo, normal, alpha, alpha2);
+          wi = reflect(ray_direction, half_vector);
+          const float ndotl = dot(normal, wi);
+          if (ndotl <= 0.0f) {
+            break;
+          }
+          const float vdoth = saturate(dot(wo, half_vector));
+          brdf_weight = fresnel_schlick(f0, vdoth) *
+                        smith_g2_over_g1(ndotv, ndotl, alpha2) /
+                        max(1.0f - diffuse_probability, 1e-3f);
+        }
+        else {
+          wi = sample_cosine_hemisphere(rng.next(), rng.next(), normal);
+          const float3 f_env = nrd_environment_term(f0, ndotv, roughness);
+          brdf_weight = diffuse_color * (float3(1.0f) - f_env) /
+                        max(diffuse_probability, 1e-3f);
+        }
+
+        const float lsum_luma = luminance(path_lsum);
+        const float importance = (lsum_luma > 1e-6f) ?
+                                     saturate(luminance(bounce_radiance) / lsum_luma) :
+                                     1.0f;
+        const float trimmed_hit_distance = hit_distance < 1e-3f ? 0.0f : hit_distance;
+        const float lens_hit_distance = trimmed_hit_distance /
+                                        (2.0f * path_curvature * trimmed_hit_distance + 1.0f);
+        path_hitdist += lens_hit_distance * (1.0f - smoothstep(0.0f, 0.2f, path_diffuse_motion));
+        path_lsum += bounce_radiance;
+        const float diffuse_like = sample_specular ?
+                                       estimate_diffuse_probability_biased(
+                                           diffuse_color, f0, ndotv, roughness) :
+                                       1.0f;
+        path_diffuse_motion += 1.0f - importance * (1.0f - diffuse_like);
+        path_curvature += curvature;
+
+        throughput = min(throughput * brdf_weight, float3(100.0f));
+        if (!valid_radiance(throughput) || max_component(throughput) <= 0.0f) {
+          break;
+        }
+
+        const float throughput_luma = luminance(throughput);
+        if ((debug_flags & 16u) != 0u) {
+          const float rr_probability = max(pow(max(throughput_luma, 0.0f), 0.25f), 0.01f);
+          if (rng.next() > rr_probability) {
+            break;
+          }
+          throughput /= rr_probability;
+        }
+        else if (throughput_luma < 0.001f) {
+          break;
+        }
+
+        ray_origin = hit_position + offset_normal * ray_epsilon;
+        ray_direction = safe_normalize(wi, normal);
+      }
+
+      if (primary_specular) {
+        spec_hitdist = path_hitdist;
+      }
+      else {
+        diff_hitdist = path_hitdist;
+      }
+    }
+  }
+
+  diff_radiance = valid_radiance(diff_radiance) ? max(diff_radiance, float3(0.0f)) :
+                                                  float3(0.0f);
+  spec_radiance = valid_radiance(spec_radiance) ? max(spec_radiance, float3(0.0f)) :
+                                                  float3(0.0f);
+  direct_radiance = valid_radiance(direct_radiance) ? direct_radiance : float3(0.0f);
+  /* USE_MOVING_EMISSION_FIX: feed a small energy-conserving fraction of primary emission
+   * through both denoised channels so an animated emitter cannot leave a dark tail. The
+   * remainder stays in the sharp DirectEmission channel added by the composite pass.
+   *
+   * IMPORTANT: NRD-Sample adds this proxy to the DEMODULATED radiance
+   * (TraceOpaque.cs.hlsl: `demodulatedRadiance += materialProps0.Lemi / Pi(2)`). It must NOT be
+   * added to the modulated signal here, because the `1 / diff_factor` demodulation below would
+   * then amplify it up to 50x on a dark-colored emitter (factor min 0.02). REBLUR spatially
+   * smears that inflated chroma into the neighboring floor as a pink haze. The proxy is added
+   * to the demodulated NRD input a few lines down instead. Keep `radiance`/frag_out consistent
+   * by adding the 2x proxy back explicitly here (energy conservation vs DirectEmission). */
+  const float3 emission_proxy = primary_emission / (2.0f * 3.14159265358979323846f);
+  primary_emission = max(primary_emission - 2.0f * emission_proxy, float3(0.0f));
+  /* Final safety clamp on the indirect signal. Use the UI's "clamp indirect" value so it has a
+   * real effect on the denoiser input; a hard-coded 1000 let red fireflies through. clamp <= 0
+   * means "no clamp" (see clamp_radiance_luminance_preserving). */
+  const float indirect_clamp = srt.pathtracing_data.clamp_indirect;
+  diff_radiance = clamp_radiance_luminance_preserving(diff_radiance, indirect_clamp);
+  spec_radiance = clamp_radiance_luminance_preserving(spec_radiance, indirect_clamp);
+  /* The 2x emission proxy was moved out of diff/spec_radiance (see above); add it back so the
+   * final combined image keeps exactly the same emission energy as before. */
+  radiance = diff_radiance + spec_radiance + 2.0f * emission_proxy;
+  /* EEVEE combined alpha stores transmittance (film converts with 1-alpha), so 0 = opaque. */
+  frag_out.color = float4(radiance + direct_radiance, 0.0f);
+
+  /* NRD's compute shaders use a top-down origin (pixelPos.y == 0 is the top, ndc.y == +1),
+   * while the fullscreen raster pass has frag_co.y == 0 at the bottom. Flip Y only for the
+   * textures consumed by NRD; direct lighting and the auxiliary SSBO stay in raster space. */
+  const int2 frag_texel = int2(frag_co.xy);
+  const int2 nrd_texel = int2(frag_texel.x,
+                              int(srt.pathtracing_data.resolution.y) - 1 - frag_texel.y);
+  imageStore(srt.out_normal_roughness_img,
+             nrd_texel,
+             pack_normal_roughness(nrd_normal, nrd_roughness, nrd_material_id));
+  imageStore(srt.out_viewz_img, nrd_texel, float4(nrd_viewz));
+  /* Demodulate so the denoiser works on irradiance (NRD requirement). Factors are stored in
+   * separate targets and re-applied in the composite pass. REBLUR additionally expects YCoCg
+   * encoded radiance and a normalized hit distance in alpha. Both first-bounce lobes are
+   * traced, so both channels carry their own hit distance. */
+  const float diff_hit_distance = reblur_norm_hit_distance(diff_hitdist, nrd_viewz, 1.0f);
+  const float spec_hit_distance = reblur_norm_hit_distance(spec_hitdist, nrd_viewz, nrd_roughness);
+  /* Demodulate for NRD. The emission proxy is added HERE (after demodulation), matching
+   * NRD-Sample's `demodulatedRadiance += Lemi / Pi(2)`. If it is added before demodulation the
+   * `1 / diff_factor` (min 0.02) amplifies its chroma up to 50x and REBLUR smears a pink haze
+   * across the neighboring floor. The UI's clamp_indirect bounds both the final image and the
+   * denoiser input (clamp <= 0 disables it). */
+  float3 denoised_diff_input = clamp_radiance_luminance_preserving(
+      diff_radiance / diff_factor + emission_proxy, indirect_clamp);
+  float3 denoised_spec_input = clamp_radiance_luminance_preserving(
+      spec_radiance / spec_factor + emission_proxy, indirect_clamp);
+  imageStore(srt.out_diffuse_img,
+             nrd_texel,
+             float4(linear_to_ycocg(denoised_diff_input), diff_hit_distance));
+  imageStore(srt.out_specular_img,
+             nrd_texel,
+             float4(linear_to_ycocg(denoised_spec_input), spec_hit_distance));
+  imageStore(srt.out_direct_img, frag_texel, float4(direct_radiance, nrd_viewz));
+
+  const uint aux_index = uint(frag_co.y) * srt.pathtracing_data.resolution.x +
+                         uint(frag_co.x);
+  srt.out_aux_buf[aux_index].diff_factor = float4(diff_factor,
+                                                  has_sun ? saturate(
+                                                                luminance(sun_direct_radiance) /
+                                                                max(luminance(direct_radiance),
+                                                                    1e-6f)) :
+                                                            0.0f);
+  srt.out_aux_buf[aux_index].spec_factor = float4(spec_factor, 0.0f);
+  srt.out_aux_buf[aux_index].emission = float4(primary_emission, 0.0f);
+  const float packed_penumbra = has_sun ?
+                                    ((sun_penumbra >= 1.0e5f) ?
+                                         65504.0f :
+                                         min(sun_penumbra * tan_sun_radius, 32768.0f)) :
+                                    0.0f;
+  imageStore(srt.out_shadow_img, nrd_texel, float4(packed_penumbra));
+  float2 nrd_motion = float2(0.0f);
+  float nrd_motion_z = 0.0f;
+  if (primary_hit) {
+    /* NRD's 2.5D motion z (viewZprev - viewZ) must be provided even when the previous
+     * position projects outside the screen: the disocclusion tests consume the view-Z
+     * delta, and out-of-screen history is rejected independently by NRD's in-screen
+     * check. Zeroing z here falsely reported "no camera motion" on camera dolly. */
+    const float prev_viewz = (srt.pathtracing_data.prev_world_to_view *
+                              float4(primary_prev_hit_position, 1.0f))
+                                 .z;
+    nrd_motion_z = prev_viewz - nrd_viewz;
+    float2 prev_uv;
+    float2 curr_uv;
+    if (project_screen_uv_unbounded(srt.pathtracing_data.prev_world_to_view,
+                                    srt.pathtracing_data.prev_view_to_clip,
+                                    primary_prev_hit_position,
+                                    prev_uv) &&
+        project_screen_uv_unbounded(srt.pathtracing_data.curr_world_to_view,
+                                    srt.pathtracing_data.curr_view_to_clip,
+                                    primary_hit_position,
+                                    curr_uv)) {
+      /* Both current and previous hit points are projected with un-jittered matrices, so no
+       * manual jitter delta is needed (matching NRD-Sample's GetMotion). Since the NRD input
+       * textures are stored top-down (Y flipped), flip the Y component of the motion too. */
+      const float2 resolution_f = float2(srt.pathtracing_data.resolution);
+      nrd_motion.x = (prev_uv.x - curr_uv.x) * resolution_f.x;
+      nrd_motion.y = -(prev_uv.y - curr_uv.y) * resolution_f.y;
+    }
+  }
+  if ((debug_flags & 8u) != 0u) {
+    nrd_motion = float2(0.0f);
+    nrd_motion_z = 0.0f;
+  }
+  imageStore(srt.out_motion_img, nrd_texel, float4(nrd_motion, nrd_motion_z, 0.0f));
+}
+
+PipelineGraphic debug(vert, frag);
+
+}  // namespace eevee::pathtracing

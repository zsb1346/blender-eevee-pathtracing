+      }
+
+      if (light_type != 1u && cast_shadow) {
+        rayQuery shadow_query;
+        rayQueryInitialize(shadow_query,
+                           srt.scene_as,
+                           gpu_RayFlagsTerminateOnFirstHit,
+                           0x01u,
+                           primary_hit_position + p_offset_normal * p_ray_epsilon,
+                           p_ray_epsilon,
+                           wi,
+                           max(shadow_distance - p_ray_epsilon, 0.0f));

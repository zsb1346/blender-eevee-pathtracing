@@ -0,0 +1,876 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Hardware ray tracing path tracing pass.
+ */
+
+#pragma once
+
+#include "draw_view.bsl.hh"
+#include "eevee_pathtracing_shared.hh"
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::pathtracing {
+
+struct Resources {
+  [[uniform(1)]] const PathTracingData &pathtracing_data;
+  [[storage(0, read)]] const InstanceRecord (&instance_buf)[];
+  [[storage(1, read)]] const PrimitiveRecord (&primitive_buf)[];
+  [[storage(2, read)]] const MaterialRecord (&material_buf)[];
+  [[storage(3, read)]] const LightRecord (&light_buf)[];
+  [[acceleration_structure(0)]] const accelerationStructure scene_as;
+  [[image(0, write, UNORM_10_10_10_2)]] image2D out_normal_roughness_img;
+  [[image(1, write, SFLOAT_32)]] image2D out_viewz_img;
+  [[image(2, write, SFLOAT_16_16_16_16)]] image2D out_diffuse_img;
+  [[image(3, write, SFLOAT_16_16_16_16)]] image2D out_motion_img;
+  [[image(4, write, SFLOAT_16_16_16_16)]] image2D out_specular_img;
+  [[image(5, write, SFLOAT_16_16_16_16)]] image2D out_diff_factor_img;
+  [[image(6, write, SFLOAT_16_16_16_16)]] image2D out_spec_factor_img;
+  /* Primary-surface direct lighting (RGB), added after denoising like the NRD sample.
+   * A stores view-space Z for the composite pass. */
+  [[image(7, write, SFLOAT_16_16_16_16)]] image2D out_direct_img;
+};
+
+struct PathtracingFragOut {
+  [[frag_color(0)]] float4 color;
+};
+
+float3 safe_normalize(float3 v, float3 fallback)
+{
+  float len_sq = dot(v, v);
+  if (len_sq < 1e-12f) {
+    return fallback;
+  }
+  return v * (1.0f / sqrt(len_sq));
+}
+
+/* Matches NRD's default R10G10B10A2 normal/roughness encoding. The alpha channel stores the
+ * NRD material ID in [0,1], where the NRD sample uses 0 = default, 1/3 = metal. */
+float4 pack_normal_roughness(float3 n, float roughness, float material_id)
+{
+  n /= abs(n.x) + abs(n.y) + abs(n.z);
+  float3 r;
+  r.y = n.y * 0.5f + 0.5f;
+  r.x = n.x * 0.5f + r.y;
+  r.y -= n.x * 0.5f;
+  roughness = max(roughness, 1.5f / 512.0f);
+  const float s = n.z < 0.0f ? -roughness : roughness;
+  r.z = s * 0.5f + 0.5f;
+  return float4(r, saturate(material_id / 3.0f));
+}
+
+uint hash_u32(uint x)
+{
+  x ^= x >> 16u;
+  x *= 0x7feb352du;
+  x ^= x >> 15u;
+  x *= 0x846ca68bu;
+  x ^= x >> 16u;
+  return x;
+}
+
+struct Rng {
+  uint state;
+  float next()
+  {
+    state = state * 747796405u + 2891336453u;
+    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
+    return float((word >> 22u) ^ word) * (1.0f / 4294967295.0f);
+  }
+};
+
+float3 sample_cosine_hemisphere(float u1, float u2, float3 normal)
+{
+  const float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
+  const float3 tangent = safe_normalize(cross(up, normal), float3(1.0f, 0.0f, 0.0f));
+  const float3 bitangent = cross(normal, tangent);
+  const float radius = sqrt(u1);
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return safe_normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) +
+                            normal * sqrt(max(0.0f, 1.0f - u1)),
+                        normal);
+}
+
+float3 sample_sphere_direction(float u1, float u2)
+{
+  const float z = 1.0f - 2.0f * u1;
+  const float radius = sqrt(max(0.0f, 1.0f - z * z));
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return float3(radius * cos(phi), radius * sin(phi), z);
+}
+
+float3 fresnel_schlick(float3 f0, float vdot_h)
+{
+  return f0 + (float3(1.0f) - f0) * pow(1.0f - saturate(vdot_h), 5.0f);
+}
+
+float ggx_distribution(float ndot_h, float alpha2)
+{
+  const float denom = ndot_h * ndot_h * (alpha2 - 1.0f) + 1.0f;
+  return alpha2 / max(3.14159265358979323846f * denom * denom, 1e-7f);
+}
+
+float smith_g1(float ndot_x, float alpha2)
+{
+  return 2.0f * ndot_x / max(ndot_x + sqrt(alpha2 + (1.0f - alpha2) * ndot_x * ndot_x), 1e-5f);
+}
+
+float3 sample_ggx_half_vector(float u1, float u2, float3 normal, float alpha2)
+{
+  const float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
+  const float3 tangent = safe_normalize(cross(up, normal), float3(1.0f, 0.0f, 0.0f));
+  const float3 bitangent = cross(normal, tangent);
+  const float cos_theta = sqrt(max((1.0f - u1) / (1.0f + (alpha2 - 1.0f) * u1), 0.0f));
+  const float sin_theta = sqrt(max(0.0f, 1.0f - cos_theta * cos_theta));
+  const float phi = 2.0f * 3.14159265358979323846f * u2;
+  return safe_normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
+                            normal * cos_theta,
+                        normal);
+}
+
+float max_component(float3 v)
+{
+  return max(v.x, max(v.y, v.z));
+}
+
+/* Intersect a ray with a Blender area light's emitting plane. Used for BSDF-sampled
+ * direct specular, which has much lower variance than uniform area sampling on smooth
+ * surfaces (the area light is not part of the ray traced scene). */
+bool intersect_area_light(const LightRecord light,
+                          float3 origin,
+                          float3 direction,
+                          float3 &point,
+                          float &distance)
+{
+  const float3 light_normal = light.direction_power.xyz;
+  const float denom = dot(direction, light_normal);
+  if (denom >= -1e-5f) {
+    return false;
+  }
+  const float t = dot(light.position_type.xyz - origin, light_normal) / denom;
+  if (t <= 1e-4f) {
+    return false;
+  }
+  point = origin + direction * t;
+  const float3 rel = point - light.position_type.xyz;
+  const float u = dot(rel, light.area_right.xyz);
+  const float v = dot(rel, light.area_up.xyz);
+  const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+  const uint shape = uint(light.area_right.w);
+  bool inside;
+  if (shape == 4u) {
+    inside = (u * u + v * v) <= half_size.x * half_size.x;
+  }
+  else if (shape == 5u) {
+    const float2 q = float2(u / max(half_size.x, 1e-5f), v / max(half_size.y, 1e-5f));
+    inside = dot(q, q) <= 1.0f;
+  }
+  else {
+    inside = abs(u) <= half_size.x && abs(v) <= half_size.y;
+  }
+  if (!inside) {
+    return false;
+  }
+  distance = t;
+  return true;
+}
+
+float area_light_area(const LightRecord light)
+{
+  const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+  const uint shape = uint(light.area_right.w);
+  if (shape == 4u) {
+    return 3.14159265358979323846f * half_size.x * half_size.x;
+  }
+  if (shape == 5u) {
+    return 3.14159265358979323846f * half_size.x * half_size.y;
+  }
+  return 4.0f * half_size.x * half_size.y;
+}
+
+/* Approximation from "Ray Tracing Gems" chapter 32, identical to NRD's environment term. */
+float3 nrd_environment_term(float3 rf0, float no_v, float roughness)
+{
+  const float m = saturate(roughness * roughness);
+  const float4 x = float4(1.0f, no_v, no_v * no_v, no_v * no_v * no_v);
+  const float4 y = float4(1.0f, m, m * m, m * m * m);
+
+  const float bias_num = (0.99044f * x.x + 1.29678f * x.y) * y.x +
+                         (-1.28514f * x.x - 0.755907f * x.y) * y.y;
+  const float bias_den = (1.0f * x.x + 20.3225f * x.y + 121.563f * x.w) * y.x +
+                         (2.92338f * x.x - 27.0302f * x.y + 626.13f * x.w) * y.y +
+                         (59.4188f * x.x + 222.592f * x.y + 316.627f * x.w) * y.w;
+  const float scale_num = (0.0365463f * x.x + 9.0632f * x.y) * y.x +
+                          (3.32707f * x.x - 9.04756f * x.y) * y.y;
+  const float scale_den = (1.0f * x.x + 9.04401f * x.z + 5.56589f * x.w) * y.x +
+                          (3.59685f * x.x - 16.3174f * x.z + 19.7886f * x.w) * y.y +
+                          (-1.36772f * x.x + 9.22949f * x.z - 20.2123f * x.w) * y.w;
+
+  const float bias = bias_num / max(bias_den, 1e-6f);
+  const float scale = scale_num / max(scale_den, 1e-6f);
+  return saturate(rf0 * scale + bias);
+}
+
+/* Matches NRD's NRD_MaterialFactors: removes the primary surface BRDF from the denoiser
+ * input. The same factors are re-applied in the composite pass. */
+void nrd_material_factors(float3 n,
+                          float3 v,
+                          float3 albedo,
+                          float3 rf0,
+                          float roughness,
+                          float3 &diff_factor,
+                          float3 &spec_factor)
+{
+  const float3 f_env = nrd_environment_term(rf0, abs(dot(n, v)), roughness);
+  diff_factor = mix(float3(0.02f), float3(1.0f), (float3(1.0f) - f_env) * albedo);
+  spec_factor = f_env * mix(0.1f, 1.0f, roughness);
+  spec_factor = mix(float3(0.02f), float3(1.0f), spec_factor);
+}
+
+/* REBLUR works in YCoCg space. The denoiser input radiance must be converted on the way in and
+ * the denoised output must be converted back on the way out (NRD_Sample uses
+ * REBLUR_FrontEnd_PackRadianceAndNormHitDist and REBLUR_BackEnd_UnpackRadianceAndNormHitDist).
+ * Feeding linear RGB to REBLUR (as RELAX expects) silently shifts the hue, e.g. neutral grey
+ * surfaces turn pink. */
+float3 linear_to_ycocg(float3 color)
+{
+  const float y = dot(color, float3(0.25f, 0.5f, 0.25f));
+  const float co = dot(color, float3(0.5f, 0.0f, -0.5f));
+  const float cg = dot(color, float3(-0.25f, 0.5f, -0.25f));
+  return float3(y, co, cg);
+}
+
+float3 ycocg_to_linear(float3 color)
+{
+  const float t = color.x - color.z;
+  return max(float3(t + color.y, color.x + color.z, t - color.y), float3(0.0f));
+}
+
+/* Matches _REBLUR_GetHitDistanceNormalization with the default ReblurHitDistanceParameters
+ * (A = 3, B = 0.1, C = 20, D = -25). REBLUR expects the hit distance normalized to [0, 1] in
+ * the alpha channel of IN_DIFF_RADIANCE_HITDIST / IN_SPEC_RADIANCE_HITDIST. */
+float reblur_norm_hit_distance(float hit_distance, float view_z, float roughness)
+{
+  const float m = saturate(roughness * roughness);
+  const float scale = (3.0f + abs(view_z) * 0.1f) * mix(1.0f, 20.0f, saturate(exp2(-25.0f * m)));
+  return saturate(hit_distance / max(scale, 1e-4f));
+}
+
+/* NRD-Sample's EstimateDiffuseProbability: lobe selection probability from the approximate
+ * environment Fresnel term. This is what gives dielectric surfaces their specular reflections
+ * while keeping metals fully specular. */
+float estimate_diffuse_probability(float3 albedo, float3 rf0, float no_v, float roughness)
+{
+  const float3 f_env = nrd_environment_term(rf0, no_v, roughness);
+  const float lum_spec = dot(f_env, float3(0.2126f, 0.7152f, 0.0722f));
+  const float lum_diff = dot(albedo * (float3(1.0f) - f_env),
+                             float3(0.2126f, 0.7152f, 0.0722f));
+  if (lum_diff <= 1e-5f) {
+    return 0.0f;
+  }
+  if (lum_spec <= 1e-5f) {
+    return 1.0f;
+  }
+  return clamp(lum_diff / (lum_diff + lum_spec), 1.0f / 64.0f, 1.0f - 1.0f / 64.0f);
+}
+
+/* Transform a world-space hit into the object's previous world transform. */
+float3 to_previous_world(const InstanceRecord instance, float3 world_position)
+{
+  const float4 local = inverse(instance.object_to_world) * float4(world_position, 1.0f);
+  return (instance.prev_object_to_world * local).xyz;
+}
+
+bool previous_screen_uv(const PathTracingData data, float3 prev_world_position, float2 &uv)
+{
+  const float4 clip = data.prev_view_to_clip *
+                      (data.prev_world_to_view * float4(prev_world_position, 1.0f));
+  if (clip.w <= 1e-6f) {
+    return false;
+  }
+  uv = clip.xy / clip.w * 0.5f + 0.5f;
+  return uv.x >= 0.0f && uv.x < 1.0f && uv.y >= 0.0f && uv.y < 1.0f;
+}
+
+[[vertex]] void vert([[vertex_id]] const int vert_id, [[position]] float4 &out_pos)
+{
+  fullscreen_vertex(vert_id, out_pos);
+}
+
+[[fragment]] void frag([[frag_coord]] const float4 frag_co,
+                       [[resource_table]] Resources &srt,
+                       [[resource_table]] const draw::View &views,
+                       [[out]] PathtracingFragOut &frag_out)
+{
+  const float2 resolution = float2(srt.pathtracing_data.resolution);
+  /* The render view already contains the film's sub-pixel jitter. Adding the sample jitter here
+   * again would double-jitter the rays and desynchronize them from the motion vectors. */
+  const float2 screen_uv = frag_co.xy / resolution;
+
+  const ViewMatrices view = views.get(0);
+  const float3 near_point = view.point_screen_to_world(float3(screen_uv, 0.0f));
+  const float3 far_point = view.point_screen_to_world(float3(screen_uv, 1.0f));
+
+  Rng rng;
+  rng.state = hash_u32(uint(frag_co.x) + uint(frag_co.y) * uint(resolution.x) +
+                       srt.pathtracing_data.sample_index * 9781u);
+
+  float3 ray_origin = near_point;
+  float3 ray_direction = safe_normalize(far_point - near_point, float3(0.0f, 0.0f, -1.0f));
+
+  float3 radiance = float3(0.0f);
+  /* NRD splits the signal into diffuse and specular channels. Paths are classified by
+   * their first-bounce lobe (same approach as the NRD sample). */
+  float3 diff_radiance = float3(0.0f);
+  float3 spec_radiance = float3(0.0f);
+  /* Direct lighting at the primary surface. Kept out of the denoiser input (NRD sample
+   * composites it after denoising) so moving shadows cannot leave history trails. */
+  float3 direct_radiance = float3(0.0f);
+
+  float3 nrd_normal = float3(0.0f, 0.0f, 1.0f);
+  float nrd_material_id = 0.0f;
+  float nrd_roughness = 1.0f;
+  /* NRD expects raw view-space Z. Blender looks down -Z, so hits are negative.
+   * Sky is sign(viewZ) * INF (see NRD sample TraceOpaque.cs.hlsl). */
+  float nrd_viewz = uintBitsToFloat(0xFF800000u);
+  float diff_hitdist = 0.0f;
+  float spec_hitdist = 0.0f;
+  float3 primary_hit_position = float3(0.0f);
+  float3 primary_prev_hit_position = float3(0.0f);
+  bool primary_hit = false;
+  float3 diff_factor = float3(1.0f);
+  float3 spec_factor = float3(1.0f);
+
+  const float3 background = srt.pathtracing_data.background.rgb;
+  const float inv_pi = 0.3183098861837907f;
+
+  const uint max_bounces = max(srt.pathtracing_data.max_bounces, 1u);
+  const uint debug_flags = srt.pathtracing_data.pad0;
+
+  /* Trace both first-bounce lobes deterministically (like NRD-Sample's full-resolution
+   * mode). Picking one lobe at random leaves one NRD channel empty every frame and makes
+   * both diffuse and specular significantly noisier after denoising. */
+  for (uint lobe = 0u; lobe < 2u; lobe++) {
+    const bool primary_specular = (lobe == 1u);
+    bool path_is_specular = primary_specular;
+    float path_hitdist = 0.0f;
+    float3 throughput = float3(1.0f);
+
+    for (uint bounce = 0u; bounce < max_bounces; bounce++) {
+
+    /* --------------------------------------------------------
+     * 1. 涓诲皠绾块亶鍘?(淇锛氫娇鐢?None 鑾峰彇鏈€杩戜氦鐐?
+     * -------------------------------------------------------- */
+    rayQuery query;
+    rayQueryInitialize(
+        query, srt.scene_as, gpu_RayFlagsNone, 0xFFu, ray_origin, 1e-4f, ray_direction, 1e30f);
+    while (rayQueryProceed(query)) {
+    }
+
+    if (rayQueryGetIntersectionType(query, true) == gpu_RayQueryCommittedIntersectionNone) {
+      if (bounce == 1u) {
+        /* The first secondary ray escaped: the path length is effectively infinite. */
+        path_hitdist = 1.0e5f;
+      }
+      else {
+        /* Primary miss: the composite pass uses the raw signal for sky pixels. Only one
+         * of the two lobe paths must write it, otherwise the background is doubled. */
+        if (lobe != 0u) {
+          break;
+        }
+      }
+      float3 background_radiance = throughput * background;
+      const float background_clamp = (bounce > 0u) ? srt.pathtracing_data.clamp_indirect :
+                                                     srt.pathtracing_data.clamp_direct;
+      if (background_clamp > 0.0f) {
+        background_radiance = min(background_radiance, float3(background_clamp));
+      }
+      if (path_is_specular) {
+        spec_radiance += background_radiance;
+      }
+      else {
+        diff_radiance += background_radiance;
+      }
+      break;
+    }
+
+    /* --------------------------------------------------------
+     * 2. 鑾峰彇鍛戒腑鐗╀綋鍜屾潗璐?(淇锛氳秺鐣屾椂缁熶竴搴旂敤 Clamp)
+     * -------------------------------------------------------- */
+    const uint instance_id = rayQueryGetIntersectionInstanceCustomIndex(query, true);
+    const uint primitive_index = rayQueryGetIntersectionPrimitiveIndex(query, true);
+
+    if (instance_id >= srt.pathtracing_data.instance_count) {
+      if (path_is_specular) {
+        spec_radiance += throughput * background;
+      }
+      else {
+        diff_radiance += throughput * background;
+      }
+      break;
+    }
+
+    const InstanceRecord instance = srt.instance_buf[instance_id];
+    const uint primitive_id = instance.primitive_offset + primitive_index;
+
+    if (primitive_id >= srt.pathtracing_data.primitive_count) {
+      if (path_is_specular) {
+        spec_radiance += throughput * background;
+      }
+      else {
+        diff_radiance += throughput * background;
+      }
+      break;
+    }
+
+    const PrimitiveRecord primitive = srt.primitive_buf[primitive_id];
+
+    if (primitive.material_id >= srt.pathtracing_data.material_count) {
+      if (path_is_specular) {
+        spec_radiance += throughput * background;
+      }
+      else {
+        diff_radiance += throughput * background;
+      }
+      break;
+    }
+
+    const MaterialRecord material = srt.material_buf[primitive.material_id];
+
+    const float hit_distance = rayQueryGetIntersectionT(query, true);
+    const float3 hit_position = ray_origin + ray_direction * hit_distance;
+    /* NRD expects the hit distance of the first secondary hit, not the sum of all path
+     * segments. NRD-Sample's accumulatedHitDist stops accumulating once the path becomes
+     * diffuse-like, and the NRD README recommends the first-bounce hit distance as the
+     * baseline for both diffuse and specular. Summing every bounce saturates the normalized
+     * guide and makes REBLUR blur indirect radiance across the platform edge (red ring). */
+    if (bounce == 1u) {
+      path_hitdist = hit_distance;
+    }
+
+    /* --------------------------------------------------------
+     * 3. 娉曠嚎璁＄畻
+     * -------------------------------------------------------- */
+    const float3x3 object_matrix = float3x3(instance.object_to_world[0].xyz,
+                                            instance.object_to_world[1].xyz,
+                                            instance.object_to_world[2].xyz);
+    const float3x3 normal_matrix = transpose(inverse(object_matrix));
+
+    const float3 geometric_normal = safe_normalize(normal_matrix * primitive.normal.xyz,
+                                                   float3(0.0f, 0.0f, 1.0f));
+    const bool front_face = dot(geometric_normal, ray_direction) < 0.0f;
+
+    const float2 bary = rayQueryGetIntersectionBarycentrics(query, true);
+    const float3 bary3 = float3(1.0f - bary.x - bary.y, bary.x, bary.y);
+
+    const float3 n0 = normal_matrix * primitive.normal0.xyz;
+    const float3 n1 = normal_matrix * primitive.normal1.xyz;
+    const float3 n2 = normal_matrix * primitive.normal2.xyz;
+
+    float3 shading_normal = n0 * bary3.x + n1 * bary3.y + n2 * bary3.z;
+    shading_normal = safe_normalize(shading_normal, geometric_normal);
+
+    if (dot(shading_normal, geometric_normal) < 0.0f) {
+      shading_normal = -shading_normal;
+    }
+
+    const float3 normal = front_face ? shading_normal : -shading_normal;
+
+    // 鍔ㄦ€佽绠楀亸绉婚噺
+    const float normal_deviation = 1.0f - saturate(dot(shading_normal, geometric_normal));
+    const float ray_epsilon = 1e-4f + hit_distance * 1e-6f + normal_deviation * 1e-4f;
+    const float3 offset_normal = front_face ? geometric_normal : -geometric_normal;
+
+    /* --------------------------------------------------------
+     * 4. 鏉愯川鍙傛暟 (淇锛氬幓闄ゆ浠ｇ爜)
+     * -------------------------------------------------------- */
+    const float3 base_color = material.base_color.rgb;
+    const float roughness = clamp(material.params.x, 0.05f, 1.0f);
+    const float metallic = clamp(material.params.y, 0.0f, 1.0f);
+    const float ior = 1.5f;
+
+    /* Primary specular indirect is the noisiest path on smooth dielectrics, while its
+     * energy is only the Fresnel tail. The area light's specular reflection is handled
+     * by BSDF-sampled direct lighting below, so skip this path for dielectrics. */
+    if (bounce == 0u && primary_specular && metallic < 0.5f) {
+      break;
+    }
+
+    if (bounce == 0u) {
+      /* NRD requires world-space normals. */
+      nrd_normal = normal;
+      nrd_roughness = roughness;
+      nrd_material_id = metallic > 0.5f ? 1.0f : 0.0f;
+      nrd_viewz = view.point_world_to_view(hit_position).z;
+      primary_hit_position = hit_position;
+      primary_prev_hit_position = to_previous_world(instance, hit_position);
+      primary_hit = true;
+    }
+
+    const float3 diffuse_color = base_color * (1.0f - metallic);  /* No transmission yet. */
+    const float dielectric_f0 = pow((ior - 1.0f) / (ior + 1.0f), 2.0f);
+    const float3 f0 = float3(dielectric_f0) * (1.0f - metallic) + base_color * metallic;
+    const float alpha = roughness * roughness;
+    const float alpha2 = alpha * alpha;
+    const float3 wo = -ray_direction;
+    const float ndotv = max(dot(normal, wo), 1e-4f);
+
+    if (bounce == 0u) {
+      nrd_material_factors(normal, wo, diffuse_color, f0, roughness, diff_factor, spec_factor);
+    }
+
+    /* --------------------------------------------------------
+     * 5. Direct lighting with shadow rays.
+     * -------------------------------------------------------- */
+    if (bounce > 0u || lobe == 0u) {
+      /* Multiple primary samples are cheap and remove most of the direct-light noise on
+       * large area lights. Secondary bounces stay at one sample and are handled by NRD. */
+      const uint direct_samples = (bounce == 0u && (debug_flags & 2u) == 0u) ? 4u : 1u;
+      for (uint direct_sample = 0u; direct_sample < direct_samples; direct_sample++) {
+    for (uint light_id = 0u; light_id < srt.pathtracing_data.light_count; light_id++) {
+      const LightRecord light = srt.light_buf[light_id];
+      const uint light_type = uint(light.position_type.w);
+      /* Smooth surfaces get the area light sampled in the BSDF lobe instead. Uniform
+       * area sampling is far too noisy on a narrow specular lobe. */
+      const bool use_bsdf_spec = bounce == 0u && (debug_flags & 4u) == 0u &&
+                                 roughness < 0.35f && light_type == 4u;
+
+      float3 light_position = light.position_type.xyz;
+      float3 wi;
+      float3 irradiance;
+      float shadow_distance;
+
+      if (light_type == 1u) {
+        wi = safe_normalize(-light.direction_power.xyz, float3(0.0f, 0.0f, 1.0f));
+        irradiance = light.color_radius.rgb * light.direction_power.w;
+        shadow_distance = 1e30f;
+      }
+      else if (light_type == 4u) {
+        /* Blender area light: sample the emitting rectangle/disk uniformly by area. Sampling a
+         * sphere around the light (as older code did) makes large lights extend through floors
+         * and walls, producing light leaks and halos around nearby geometry. */
+        const uint area_shape = uint(light.area_right.w);
+        const float2 half_size = float2(light.spot_flags.z, light.spot_flags.w) * 0.5f;
+        const float2 uv = float2(rng.next(), rng.next());
+        float2 local;
+        if (area_shape == 4u) {
+          const float radius = sqrt(uv.x) * half_size.x;
+          const float phi = 2.0f * 3.14159265358979323846f * uv.y;
+          local = float2(cos(phi), sin(phi)) * radius;
+        }
+        else if (area_shape == 5u) {
+          const float radius = sqrt(uv.x);
+          const float phi = 2.0f * 3.14159265358979323846f * uv.y;
+          local = float2(cos(phi) * half_size.x, sin(phi) * half_size.y) * radius;
+        }
+        else {
+          local = (uv * 2.0f - 1.0f) * half_size;
+        }
+
+        light_position += light.area_right.xyz * local.x + light.area_up.xyz * local.y;
+
+        const float3 to_light = light_position - hit_position;
+        const float distance_sq = dot(to_light, to_light);
+        const float distance = sqrt(distance_sq);
+        wi = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+        /* One-sided emission: only the front side of the light contributes. */
+        const float cos_light = saturate(dot(-wi, light.direction_power.xyz));
+        if (cos_light <= 0.0f) {
+          continue;
+        }
+        /* Uniform area sampling turns radiance power / (area * pi) into this irradiance
+         * estimator (the area cancels against the sampling pdf). */
+        irradiance = light.color_radius.rgb * light.direction_power.w * cos_light /
+                     max(3.14159265358979323846f * distance_sq, 1e-3f);
+        shadow_distance = distance;
+      }
+      else {
+        /* Point/spot lights: use the center. Sampling the radius as a full sphere puts half of
+         * the samples behind an occluder and leaks light around it. */
+        const float3 to_light = light.position_type.xyz - hit_position;
+        const float distance_sq = dot(to_light, to_light);
+        const float distance = sqrt(distance_sq);
+        wi = safe_normalize(to_light, float3(0.0f, 0.0f, 1.0f));
+
+        irradiance = light.color_radius.rgb * light.direction_power.w /
+                     max(4.0f * 3.14159265358979323846f * distance_sq, 1e-3f);
+        shadow_distance = distance;
+
+        if (light_type == 2u) {
+          const float cos_angle = dot(-wi, light.direction_power.xyz);
+          const float outer_angle = light.spot_flags.x * 0.5f;
+          const float inner_angle = outer_angle * (1.0f - light.spot_flags.y);
+          const float cos_outer = cos(outer_angle);
+          const float cos_inner = cos(inner_angle);
+          if (cos_angle < cos_outer) {
+            continue;
+          }
+          const float spot = saturate((cos_angle - cos_outer) / max(cos_inner - cos_outer, 1e-5f));
+          irradiance *= spot;
+        }
+      }
+
+      const float ndotl = max(dot(normal, wi), 0.0f);
+      if (ndotl <= 0.0f || shadow_distance <= ray_epsilon) {
+        continue;
+      }
+
+      rayQuery shadow_query;
+      // minT 璁句负 0锛屼緷闈犺捣鐐瑰亸绉婚槻鑷氦
+      rayQueryInitialize(shadow_query,
+                         srt.scene_as,
+                         gpu_RayFlagsTerminateOnFirstHit,
+                         0xFFu,
+                         hit_position + offset_normal * ray_epsilon,
+                         ray_epsilon,
+                         wi,
+                          max(shadow_distance - ray_epsilon, 0.0f));
+      while (rayQueryProceed(shadow_query)) {
+      }
+
+      // 淇锛氬彧鍒ゆ柇璺濈锛屼笉鍒ゆ柇 FrontFace锛堥槻姝㈠崟闈㈡紡鍏夛級
+      if (rayQueryGetIntersectionType(shadow_query, true) != gpu_RayQueryCommittedIntersectionNone)
+      {
+        continue;
+      }
+
+      const float3 h_vec = wi + wo;
+      const float3 half_vector = (dot(h_vec, h_vec) > 1e-8f) ? safe_normalize(h_vec, normal) :
+                                                               normal;
+
+      const float ndoth = saturate(dot(normal, half_vector));
+      const float vdoth = saturate(dot(wo, half_vector));
+      const float3 fresnel = fresnel_schlick(f0, vdoth);
+      const float distribution = ggx_distribution(ndoth, alpha2);
+      const float geometry = smith_g1(ndotv, alpha2) * smith_g1(ndotl, alpha2);
+
+      const float3 specular = (distribution * geometry) * fresnel /
+                              max(4.0f * ndotl * ndotv, 1e-4f);
+
+      // 鑳介噺琛ュ伩锛氱洿鎺ュ厜鍑忓幓 Fresnel 鑳介噺锛岄槻姝㈣繃鏇?
+      float3 direct_diffuse = irradiance * ndotl * diffuse_color * inv_pi * (1.0f - fresnel);
+      float3 direct_specular = irradiance * ndotl * specular;
+      if (use_bsdf_spec) {
+        direct_specular = float3(0.0f);
+      }
+      const float direct_clamp = (bounce > 0u) ? srt.pathtracing_data.clamp_indirect :
+                                                 srt.pathtracing_data.clamp_direct;
+      if (direct_clamp > 0.0f) {
+        direct_diffuse = min(direct_diffuse, float3(direct_clamp));
+        direct_specular = min(direct_specular, float3(direct_clamp));
+      }
+
+      const float3 direct_contribution =
+          throughput * (direct_diffuse + direct_specular) / float(direct_samples);
+      if (bounce == 0u) {
+        direct_radiance += direct_contribution;
+      }
+      else if (path_is_specular) {
+        spec_radiance += direct_contribution;
+      }
+      else {
+        diff_radiance += direct_contribution;
+      }
+    }
+      }
+    }
+
+    /* BSDF-sampled direct specular for smooth surfaces and area lights. The reflected ray
+     * is intersected analytically with the light plane, then shadowed against the scene.
+     * This is the low-variance counterpart of uniform area sampling used above. */
+    if (bounce == 0u && lobe == 0u && (debug_flags & 4u) == 0u && roughness < 0.35f) {
+      const uint bsdf_samples = 4u;
+      for (uint light_id = 0u; light_id < srt.pathtracing_data.light_count; light_id++) {
+        const LightRecord light = srt.light_buf[light_id];
+        if (uint(light.position_type.w) != 4u) {
+          continue;
+        }
+        const float area = area_light_area(light);
+        if (area <= 1e-6f) {
+          continue;
+        }
+        const float3 radiance_light = light.color_radius.rgb * light.direction_power.w /
+                                      (area * 3.14159265358979323846f);
+        for (uint bsdf_sample = 0u; bsdf_sample < bsdf_samples; bsdf_sample++) {
+          const float3 half_vector = sample_ggx_half_vector(
+              rng.next(), rng.next(), normal, alpha2);
+          const float3 wi_bsdf = reflect(ray_direction, half_vector);
+          const float ndotl = dot(normal, wi_bsdf);
+          if (ndotl <= 0.0f) {
+            continue;
+          }
+          const float ndoth = saturate(dot(normal, half_vector));
+          const float vdoth = saturate(dot(wo, half_vector));
+          if (ndoth <= 1e-4f || vdoth <= 0.0f) {
+            continue;
+          }
+          float3 light_point;
+          float light_distance;
+          if (!intersect_area_light(light, hit_position, wi_bsdf, light_point, light_distance)) {
+            continue;
+          }
+          if (dot(-wi_bsdf, light.direction_power.xyz) <= 0.0f) {
+            continue;
+          }
+          rayQuery shadow_query;
+          rayQueryInitialize(shadow_query,
+                             srt.scene_as,
+                             gpu_RayFlagsTerminateOnFirstHit,
+                             0xFFu,
+                             hit_position + offset_normal * ray_epsilon,
+                             ray_epsilon,
+                             wi_bsdf,
+                             max(light_distance - ray_epsilon, 0.0f));
+          while (rayQueryProceed(shadow_query)) {
+          }
+          if (rayQueryGetIntersectionType(shadow_query, true) !=
+              gpu_RayQueryCommittedIntersectionNone) {
+            continue;
+          }
+          const float3 fresnel = fresnel_schlick(f0, vdoth);
+          const float geometry = smith_g1(ndotv, alpha2) * smith_g1(ndotl, alpha2);
+          const float3 specular_weight = geometry * fresnel * vdoth /
+                                         max(ndotv * ndoth, 1e-4f);
+          float3 contribution = throughput * specular_weight * radiance_light;
+          const float direct_clamp = srt.pathtracing_data.clamp_direct;
+          if (direct_clamp > 0.0f) {
+            contribution = min(contribution, float3(direct_clamp));
+          }
+          direct_radiance += contribution / float(bsdf_samples);
+        }
+      }
+    }
+
+    /* --------------------------------------------------------
+     * 6. Indirect lighting. The lobe is picked with the same Fresnel-weighted probability as the
+     * NRD sample, so dielectrics keep their specular reflection instead of being pure Lambert.
+     * -------------------------------------------------------- */
+    float3 wi;
+    float3 brdf_weight;
+
+    const float diffuse_probability = estimate_diffuse_probability(
+        diffuse_color, f0, ndotv, roughness);
+    bool sample_specular;
+    if (bounce == 0u) {
+      /* Primary: both lobes are traced deterministically, so no lobe-selection noise. */
+      sample_specular = primary_specular;
+      path_is_specular = primary_specular;
+    }
+    else {
+      sample_specular = rng.next() >= diffuse_probability;
+    }
+
+    if (sample_specular) {
+      const float3 half_vector = sample_ggx_half_vector(rng.next(), rng.next(), normal, alpha2);
+      wi = reflect(ray_direction, half_vector);
+      const float ndotl = dot(normal, wi);
+      if (ndotl <= 0.0f) {
+        break;
+      }
+
+      const float ndoth = saturate(dot(normal, half_vector));
+      const float vdoth = saturate(dot(wo, half_vector));
+      const float3 fresnel = fresnel_schlick(f0, vdoth);
+      const float geometry = smith_g1(ndotv, alpha2) * smith_g1(ndotl, alpha2);
+
+      /* Standard GGX NDF-sampling weight. At the primary hit both lobes are traced, so
+       * there is no lobe-selection probability to divide by. */
+      brdf_weight = geometry * fresnel * vdoth / max(ndotv * ndoth, 1e-4f);
+      if (bounce > 0u) {
+        brdf_weight /= max(1.0f - diffuse_probability, 1e-3f);
+      }
+    }
+    else {
+      wi = sample_cosine_hemisphere(rng.next(), rng.next(), normal);
+      /* Cosine sampling cancels the cosine and pi of the Lambert BRDF. */
+      brdf_weight = diffuse_color;
+      if (bounce > 0u) {
+        brdf_weight /= max(diffuse_probability, 1e-3f);
+      }
+    }
+
+    // 闄愬埗涓婇檺闃叉鐖嗙偢
+    throughput = min(throughput * brdf_weight, float3(100.0f));
+
+    if (max_component(throughput) <= 0.0f) {
+      break;
+    }
+
+    ray_origin = hit_position + offset_normal * ray_epsilon;
+    ray_direction = safe_normalize(wi, normal);
+    }
+
+    if (primary_specular) {
+      spec_hitdist = path_hitdist;
+    }
+    else {
+      diff_hitdist = path_hitdist;
+    }
+  }
+
+  diff_radiance = max(diff_radiance, float3(0.0f));
+  spec_radiance = max(spec_radiance, float3(0.0f));
+  diff_radiance = min(diff_radiance, float3(1000.0f));
+  spec_radiance = min(spec_radiance, float3(1000.0f));
+  radiance = diff_radiance + spec_radiance;
+  /* EEVEE combined alpha stores transmittance (film converts with 1-alpha), so 0 = opaque. */
+  frag_out.color = float4(radiance + direct_radiance, 0.0f);
+
+  const int2 nrd_texel = int2(frag_co.xy);
+  imageStore(srt.out_normal_roughness_img,
+             nrd_texel,
+             pack_normal_roughness(nrd_normal, nrd_roughness, nrd_material_id));
+  imageStore(srt.out_viewz_img, nrd_texel, float4(nrd_viewz));
+  /* Demodulate so the denoiser works on irradiance (NRD requirement). Factors are stored in
+   * separate targets and re-applied in the composite pass. REBLUR additionally expects YCoCg
+   * encoded radiance and a normalized hit distance in alpha. Both first-bounce lobes are
+   * traced, so both channels carry their own hit distance. */
+  const float diff_hit_distance = reblur_norm_hit_distance(diff_hitdist, nrd_viewz, 1.0f);
+  const float spec_hit_distance = reblur_norm_hit_distance(spec_hitdist, nrd_viewz, nrd_roughness);
+  imageStore(srt.out_diffuse_img,
+             nrd_texel,
+             float4(linear_to_ycocg(diff_radiance / diff_factor), diff_hit_distance));
+  imageStore(srt.out_specular_img,
+             nrd_texel,
+             float4(linear_to_ycocg(spec_radiance / spec_factor), spec_hit_distance));
+  imageStore(srt.out_diff_factor_img, nrd_texel, float4(diff_factor, 1.0f));
+  imageStore(srt.out_spec_factor_img, nrd_texel, float4(spec_factor, 1.0f));
+  imageStore(srt.out_direct_img, nrd_texel, float4(direct_radiance, nrd_viewz));
+  float2 nrd_motion = float2(0.0f);
+  float nrd_motion_z = 0.0f;
+  if (primary_hit) {
+    float2 prev_uv;
+    if (previous_screen_uv(srt.pathtracing_data, primary_prev_hit_position, prev_uv)) {
+      const float2 resolution_f = float2(srt.pathtracing_data.resolution);
+      /* frag_co is already at the pixel center: no extra half-pixel offset here. */
+      const float2 curr_uv = float2(float(frag_co.x), float(frag_co.y)) / resolution_f;
+      /* NRD requires non-jittered motion vectors (NRD-Sample projects the hit point with the
+       * unjittered matrices). The current hit comes from the jittered ray, so its unjittered
+       * position is `curr_uv - curr_jitter`; `prev_view_to_clip` adds `prev_jitter`. Removing
+       * `prev_jitter - curr_jitter` leaves zero motion for a static camera. */
+      prev_uv -= (srt.pathtracing_data.prev_jitter - srt.pathtracing_data.curr_jitter) /
+                 resolution_f;
+      nrd_motion = (prev_uv - curr_uv) * resolution_f;
+      /* NRD's recommended 2.5D motion stores the view-Z change in z. This is what lets REBLUR
+       * detect disocclusion during camera dolly/zoom instead of keeping a scaled ghost. */
+      const float prev_viewz = (srt.pathtracing_data.prev_world_to_view *
+                                float4(primary_prev_hit_position, 1.0f))
+                                   .z;
+      nrd_motion_z = prev_viewz - nrd_viewz;
+    }
+  }
+  if ((debug_flags & 8u) != 0u) {
+    nrd_motion = float2(0.0f);
+    nrd_motion_z = 0.0f;
+  }
+  imageStore(srt.out_motion_img, nrd_texel, float4(nrd_motion, nrd_motion_z, 0.0f));
+}
+
+PipelineGraphic debug(vert, frag);
+
+}  // namespace eevee::pathtracing
+

+                                                        float3(1.0f, 0.0f, 0.0f);
+      const float3 tangent = safe_normalize(cross(up, sun_direction), float3(1.0f, 0.0f, 0.0f));
+      const float3 bitangent = cross(sun_direction, tangent);
+      const float radius = sqrt(rng.next()) * tan_sun_radius;
+      const float phi = 2.0f * 3.14159265358979323846f * rng.next();
